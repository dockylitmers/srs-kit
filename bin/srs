// ---------------------------------------------------------------- 공통

function die(msg) {
  process.stderr.write(`srs: ${msg}\n`);
  process.exit(2);
}

function read(file) {
  return fs.readFileSync(file, 'utf8');
}

function exists(p) {
  return fs.existsSync(p);
}

function today() {
  const d = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

function isDate(v) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(v || '')) return false;
  const d = new Date(`${v}T00:00:00Z`);
  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === v;
}

function escapeRe(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function parseArgs(argv) {
  const BOOL = new Set(['example', 'force', 'json', 'strict', 'help', 'verbose', 'all', 'edition', 'dry-run', 'copy', 'each', 'group', 'unread', 'quiet', 'changed', 'hook', 'baseline', 'save-baseline', 'prune']);
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-h') opt.help = true;
    else if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      if (eq > 0) opt[a.slice(2, eq)] = a.slice(eq + 1);
      else {
        const key = a.slice(2);
        if (BOOL.has(key)) opt[key] = true;
        else if (i + 1 < argv.length) opt[key] = argv[++i];
        else die(`--${key} 다음에 값이 없습니다`);
      }
    } else pos.push(a);
  }
  return { pos, opt };
}

function walk(dir, out = []) {
  if (!exists(dir)) return out;
  for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
    if (ent.name.startsWith('.')) continue;
    const p = path.join(dir, ent.name);
    if (ent.isDirectory()) walk(p, out);
    else out.push(p);
  }
  return out;
}

function toPosix(p) {
  return p.split(path.sep).join('/');
}

// 현재 폴더 아래면 상대 경로, 아니면 절대 경로로 보여 준다.
function shown(p) {
  const rel = path.relative(process.cwd(), p);
  return toPosix(rel && !rel.startsWith('..') ? rel : p);
}

// ---------------------------------------------------------------- 설정

function mergeConfig(base, user) {
  const out = { ...base };
  for (const [k, v] of Object.entries(user || {})) {
    if (k === 'formDirs' || k === 'numbering' && typeof v === 'boolean' || Array.isArray(v) || v === null || typeof v !== 'object') out[k] = v;
    else out[k] = mergeConfig(base[k] || {}, v);
  }
  return out;
}

function findRoot(start) {
  let dir = start;
  for (;;) {
    if (exists(path.join(dir, 'srs.config.json'))) return dir;
    const up = path.dirname(dir);
    if (up === dir) return start;
    dir = up;
  }
}

function loadConfig(opt) {
  const root = path.resolve(opt.root || findRoot(process.cwd()));
  const configPath = opt.config ? path.resolve(opt.config) : path.join(root, 'srs.config.json');
  let user = {};
  if (exists(configPath)) {
    try {
      user = JSON.parse(read(configPath));
    } catch (e) {
      die(`${configPath}: JSON을 읽을 수 없습니다 (${e.message})`);
    }
  } else if (opt.config) die(`설정 파일이 없습니다: ${configPath}`);
  const cfg = mergeConfig(DEFAULT_CONFIG, user);
  delete cfg.$comment;
  cfg.root = root;
  cfg.configPath = exists(configPath) ? configPath : null;
  cfg.docsAbs = path.resolve(root, cfg.docsDir);
  cfg.versionsAbs = path.resolve(root, cfg.versionsDir);
  cfg.ruleIdRe = new RegExp(`^${cfg.ruleIdPattern}$`);
  cfg.ruleIdGlobal = new RegExp(`(?<![\\w-])${cfg.ruleIdPattern}(?![\\w-])`, 'g');
  cfg.sourceIdGlobal = new RegExp(`(?<![\\w-])${cfg.sourceIdPattern}(?![\\w-])`, 'g');
  cfg.langs = [cfg.primaryLanguage, ...cfg.translations];
  if (typeof cfg.numbering === 'boolean') cfg.numbering = { enabled: cfg.numbering, indexPage: 'index' };
  return cfg;
}

function matchesList(slug, list) {
  return (list || []).some((p) => (p.endsWith('/') ? slug.startsWith(p) : slug === p));
}

function isGenerated(slug, cfg) {
  return matchesList(slug, cfg.generatedPages);
}

// ---------------------------------------------------------------- git

function git(cfg, args, { allowFail = false } = {}) {
  try {
    return execFileSync('git', args, { cwd: cfg.root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 });
  } catch (e) {
    if (allowFail) return null;
    die(`git ${args.join(' ')} 실패: ${(e.stderr || e.message).toString().trim()}`);
  }
}

function checkBaseRef(cfg, ref) {
  if (git(cfg, ['rev-parse', '--verify', '--quiet', `${ref}^{commit}`], { allowFail: true }) === null) die(`기준 커밋을 찾을 수 없습니다: ${ref}`);
}

// 기준 커밋의 파일 내용. 없으면 null
function gitShow(cfg, ref, absFile) {
  return git(cfg, ['show', `${ref}:./${toPosix(path.relative(cfg.root, absFile))}`], { allowFail: true });
}

// 기준 커밋 이후 바뀐(또는 새로 생긴) 문서 파일의 절대 경로
function changedDocFiles(cfg, ref) {
  const rel = toPosix(path.relative(cfg.root, cfg.docsAbs));
  const out = new Set();
  for (const line of git(cfg, ['diff', '--name-only', '--relative', ref, '--', rel]).split('\n')) if (line.trim()) out.add(path.resolve(cfg.root, line.trim()));
  for (const line of git(cfg, ['ls-files', '--others', '--exclude-standard', '--', rel]).split('\n')) if (line.trim()) out.add(path.resolve(cfg.root, line.trim()));
  return [...out].filter((f) => /\.mdx?$/.test(f));
}

// ---------------------------------------------------------------- 페이지 읽기

function parseFrontmatter(lines) {
  if (lines[0] !== '---') return { fm: {}, end: -1 };
  const fm = {};
  for (let i = 1; i < lines.length; i++) {
    if (lines[i] === '---') return { fm, end: i };
    const m = /^([A-Za-z_][\w-]*)\s*:\s*(.*)$/.exec(lines[i]);
    if (!m) continue;
    let v = m[2].replace(/\s+#.*$/, '').trim();
    if (/^".*"$/.test(v)) {
      try {
        v = JSON.parse(v);
      } catch {
        v = v.slice(1, -1);
      }
    } else if (/^'.*'$/.test(v)) v = v.slice(1, -1).replace(/''/g, "'");
    fm[m[1]] = v;
  }
  return { fm, end: -1 };
}

function splitCells(line) {
  const t = line.trim().replace(/^\|/, '').replace(/\|$/, '');
  const cells = [];
  let cur = '';
  for (let i = 0; i < t.length; i++) {
    if (t[i] === '\\' && t[i + 1] === '|') {
      cur += '|';
      i++;
    } else if (t[i] === '|') {
      cells.push(cur.trim());
      cur = '';
    } else cur += t[i];
  }
  cells.push(cur.trim());
  return cells;
}

function sectionKey(title) {
  const t = title.replace(/^[\d.\s]+/, '').trim().toLowerCase();
  for (const [key, labels] of Object.entries(SECTIONS)) {
    if (labels.some((l) => t.startsWith(l.toLowerCase()))) return key;
  }
  return null;
}

function analyzePage(file, cfg) {
  const rel = toPosix(path.relative(cfg.docsAbs, file));
  const base = path.basename(rel);
  let lang = cfg.primaryLanguage;
  let slug = rel.replace(/\.mdx?$/, '');
  for (const t of cfg.translations) {
    if (base.endsWith(`.${t}.mdx`) || base.endsWith(`.${t}.md`)) {
      lang = t;
      slug = rel.replace(new RegExp(`\\.${t}\\.mdx?$`), '');
    }
  }
  const text = read(file);
  return { file, rel, lang, slug, text, ...analyzeText(text) };
}

function analyzeText(text) {
  const raw = text.split(/\r?\n/);
  const { fm, end } = parseFrontmatter(raw);
  const lines = [];
  let fence = null;
  let inComment = false;
  for (let i = end + 1; i < raw.length; i++) {
    const r = raw[i];
    const n = i + 1;
    if (!inComment) {
      const f = /^\s*(```|~~~)/.exec(r);
      if (f) {
        if (!fence) fence = f[1];
        else if (f[1] === fence) fence = null;
        lines.push({ n, raw: r, code: '', text: '', inFence: true });
        continue;
      }
    }
    if (fence) {
      lines.push({ n, raw: r, code: '', text: '', inFence: true });
      continue;
    }
    let out = '';
    let rest = r;
    while (rest.length) {
      if (inComment) {
        const e = rest.indexOf('*/');
        if (e < 0) rest = '';
        else {
          rest = rest.slice(e + 2).replace(/^\s*\}/, '');
          inComment = false;
        }
      } else {
        const s = rest.indexOf('{/*');
        if (s < 0) {
          out += rest;
          rest = '';
        } else {
          out += rest.slice(0, s);
          rest = rest.slice(s + 3);
          inComment = true;
        }
      }
    }
    out = out.replace(/<!--.*?-->/g, '');
    lines.push({ n, raw: r, code: out, text: out.replace(/`[^`]*`/g, '``'), inFence: false });
  }

  // 제목과 절
  const headings = [];
  let h2 = null;
  let devNotesFrom = Infinity;
  for (const l of lines) {
    const m = /^(#{1,6})\s+(.*?)\s*#*\s*$/.exec(l.code);
    if (m && !l.inFence) {
      const h = { level: m[1].length, title: m[2], n: l.n, key: sectionKey(m[2]) };
      headings.push(h);
      if (h.level <= 2) h2 = h;
      if (h.key === 'devNotes' && devNotesFrom === Infinity) devNotesFrom = l.n;
    }
    l.section = h2 ? h2.key : null;
    l.sectionTitle = h2 ? h2.title : null;
  }

  // 표
  const tables = [];
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    const next = lines[i + 1];
    if (l.inFence || !l.code.trim().startsWith('|') || !next) continue;
    if (!/^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$/.test(next.code)) continue;
    const table = { header: splitCells(l.code), rows: [], n: l.n, section: l.section, sectionTitle: l.sectionTitle };
    let j = i + 2;
    for (; j < lines.length && lines[j].code.trim().startsWith('|'); j++) {
      table.rows.push({ cells: splitCells(lines[j].code).map((c) => c.replace(/`/g, '')), raw: splitCells(lines[j].code), n: lines[j].n });
    }
    tables.push(table);
    i = j - 1;
  }
  return { fm, fmEnd: end, raw, lines, headings, tables, devNotesFrom };
}

function columnIndex(table, re) {
  return table.header.findIndex((h) => re.test(h.replace(/`/g, '').trim()));
}

function loadPages(cfg) {
  if (!exists(cfg.docsAbs)) die(`문서 폴더가 없습니다: ${cfg.docsAbs}`);
  const files = walk(cfg.docsAbs).filter((f) => /\.mdx?$/.test(f));
  const pages = files.map((f) => analyzePage(f, cfg));
  const byKey = new Map(pages.map((p) => [`${p.lang}:${p.slug}`, p]));
  return { pages, get: (slug, lang) => byKey.get(`${lang || cfg.primaryLanguage}:${slug}`) };
}

function isInternal(page, cfg) {
  return (cfg.internalPages || []).some((p) => (p.endsWith('/') ? page.slug.startsWith(p) : page.slug === p));
}

function formKind(page, cfg) {
  const dir = page.slug.split('/').slice(0, -1).join('/');
  if (!(dir in cfg.formDirs)) return null;
  if (path.basename(page.slug) === 'index') return null;
  if ((cfg.guidePages || []).some((g) => (g.endsWith('/') ? page.slug.startsWith(g) : page.slug === g))) return null;
  return cfg.formDirs[dir];
}

// 규칙 정의: 첫 열이 ID인 표(예시·확인 요청·확인 기록 절 제외), 또는 "### ID. 제목" 형태의 제목.
// 팀 관리 페이지(internalPages)는 규칙을 정의하지 않는다.
function extractRules(page, cfg) {
  const rules = [];
  if (isInternal(page, cfg)) return rules;
  for (const t of page.tables) {
    if (['examples', 'questions', 'confirmations'].includes(t.section)) continue;
    if (!/^(ID|규칙 ID|요구사항 ID|Rule ID|Requirement ID)$/i.test((t.header[0] || '').trim())) continue;
    const ruleCol = columnIndex(t, /^(규칙|요구사항|Rule|Requirement)$/i);
    const srcCol = columnIndex(t, /^(출처|근거|Sources?)$/i);
    for (const r of t.rows) {
      const id = (r.cells[0] || '').trim();
      if (!cfg.ruleIdRe.test(id)) continue;
      rules.push({
        id, n: r.n, kind: 'table', tableLine: t.n,
        text: ruleCol >= 0 ? r.cells[ruleCol] || '' : r.cells.slice(1).join(' '),
        sources: srcCol >= 0 ? r.cells[srcCol] || '' : null,
      });
    }
  }
  const heads = page.headings;
  for (let i = 0; i < heads.length; i++) {
    const h = heads[i];
    if (h.level < 2) continue;
    const m = new RegExp(`^(${cfg.ruleIdPattern})(?:[.:)]|\\s)`).exec(`${h.title} `);
    if (!m) continue;
    const endLine = heads.slice(i + 1).find((x) => x.level <= h.level)?.n ?? Infinity;
    const body = page.lines.filter((l) => l.n > h.n && l.n < endLine && !l.inFence).map((l) => l.code).join('\n');
    rules.push({ id: m[1], n: h.n, kind: 'heading', text: body, sources: null });
  }
  return rules;
}

function confirmationRows(page) {
  const out = [];
  for (const t of page.tables) {
    if (t.section !== 'confirmations') continue;
    const vCol = columnIndex(t, /^(버전|Version)$/i);
    const rCol = columnIndex(t, /^(결과|Result)$/i);
    if (vCol < 0 || rCol < 0) continue;
    for (const r of t.rows) out.push({ version: (r.cells[vCol] || '').trim(), result: (r.cells[rCol] || '').trim(), n: r.n });
  }
  return out;
}

function lastConfirmedVersion(page) {
  const ok = confirmationRows(page)
    .filter((r) => isDate(r.version) && CONFIRMED_RESULT.test(r.result) && !NOT_CONFIRMED_RESULT.test(r.result))
    .map((r) => r.version)
    .sort();
  return ok.length ? ok[ok.length - 1] : null;
}

function countProposals(page, lang) {
  const mark = PROPOSAL_MARK[lang] || PROPOSAL_MARK.en;
  let count = 0;
  for (const l of page.lines) {
    if (l.inFence || l.section === 'questions' || l.n >= page.devNotesFrom) continue;
    count += l.code.split(mark).length - 1;
  }
  return count;
}

// 개발 근거 앞 본문의 표시 개수(확인 요청 절 포함)
function countMarker(page, mark) {
  let count = 0;
  const m = mark.toLowerCase();
  for (const l of page.lines) {
    if (l.inFence || l.n >= page.devNotesFrom) continue;
    count += l.text.toLowerCase().split(m).length - 1;
  }
  return count;
}

function firstColumnIds(page, section, re) {
  const ids = [];
  for (const t of page.tables) {
    if (t.section !== section) continue;
    for (const r of t.rows) {
      const id = (r.cells[0] || '').trim();
      if (re.test(id)) ids.push(id);
    }
  }
  return ids;
}

function pageVersion(page, cfg) {
  return page.fm.version || cfg.legacyVersion || null;
}

// ---------------------------------------------------------------- check

function runCheck(cfg, opt) {
  const { pages, get } = loadPages(cfg);
  const findings = [];
  const add = (level, file, line, code, msg) => findings.push({ level, file, line, code, msg });
  const relRoot = (abs) => toPosix(path.relative(cfg.root, abs));
  const primary = pages.filter((p) => p.lang === cfg.primaryLanguage);
  const docsRel = relRoot(cfg.docsAbs);

  // 1. version과 형식
  for (const p of pages) {
    const v = p.fm.version;
    if (!v) {
      if (cfg.legacyVersion) add('warn', relRoot(p.file), 1, 'version-missing', `version이 없습니다. 사이트는 ${cfg.legacyVersion}로 봅니다. 다음에 고칠 때 srs bump로 넣는다`);
      else add('error', relRoot(p.file), 1, 'version-missing', 'frontmatter에 version: "YYYY-MM-DD"가 없습니다');
    } else if (!isDate(v)) add('error', relRoot(p.file), 1, 'version-format', `version 형식이 YYYY-MM-DD가 아닙니다: ${v}`);
    if (!p.fm.title) add('warn', relRoot(p.file), 1, 'title-missing', 'frontmatter에 title이 없습니다');
  }

  // 2. 번역 짝과 버전
  const koVersionsBySlug = new Map();
  for (const p of primary) koVersionsBySlug.set(p.slug, new Set([pageVersion(p, cfg)].filter(Boolean)));
  for (const f of walk(cfg.versionsAbs)) {
    const parts = toPosix(path.relative(cfg.versionsAbs, f)).split('/');
    if (parts.length < 2 || !isDate(parts[0]) || !/\.mdx?$/.test(f)) continue;
    const slug = parts.slice(1).join('/').replace(/\.mdx?$/, '');
    if (cfg.translations.some((t) => slug.endsWith(`.${t}`))) continue;
    if (!koVersionsBySlug.has(slug)) koVersionsBySlug.set(slug, new Set());
    koVersionsBySlug.get(slug).add(parts[0]);
  }
  for (const p of primary) {
    for (const t of cfg.translations) {
      const tr = get(p.slug, t);
      if (!tr) {
        add(cfg.requireTranslations ? 'error' : 'warn', relRoot(p.file), 1, 'translation-missing', `${t} 번역 파일이 없습니다(${path.basename(p.rel).replace(/\.mdx?$/, `.${t}.mdx`)})`);
        continue;
      }
      const kv = pageVersion(p, cfg);
      const tv = pageVersion(tr, cfg);
      if (!kv || !tv || !isDate(kv) || !isDate(tv)) continue;
      if (tv > kv) add('error', relRoot(tr.file), 1, 'translation-ahead', `${t} version(${tv})이 원문(${kv})보다 늦습니다. 번역 version은 옮긴 원문 버전이다`);
      else if (tv < kv) add(cfg.allowStaleTranslations ? 'warn' : 'error', relRoot(tr.file), 1, 'translation-stale', `번역이 ${tv} 기준입니다. 원문은 ${kv}. 번역을 고친 뒤 srs bump ${p.slug} --lang ${t}`);
      if (tv < kv && !(koVersionsBySlug.get(p.slug) || new Set()).has(tv)) add('warn', relRoot(tr.file), 1, 'translation-unknown-version', `번역 version ${tv}에 해당하는 원문 버전(현재 또는 예전 버전)이 없습니다`);
      // 짝 대조: 같은 버전이면 규칙 ID, 예시, 확인 요청 행, 표시 개수가 같아야 한다
      if (tv !== kv || isInternal(p, cfg) || isGenerated(p.slug, cfg)) continue;
      const trRel = relRoot(tr.file);
      const ids = (pg) => extractRules(pg, cfg).map((r) => r.id);
      const ki = ids(p);
      const ti = ids(tr);
      if (ki.join('|') !== ti.join('|')) {
        const onlyK = ki.filter((x) => !ti.includes(x));
        const onlyT = ti.filter((x) => !ki.includes(x));
        add('error', trRel, 1, 'pair-rules', onlyK.length || onlyT.length ? `규칙 ID가 원문과 다릅니다. 원문에만: ${onlyK.join(', ') || '-'} / 번역에만: ${onlyT.join(', ') || '-'}` : '규칙 ID 순서가 원문과 다릅니다');
      }
      const exRe = /^E\d+$/;
      if (firstColumnIds(p, 'examples', exRe).join('|') !== firstColumnIds(tr, 'examples', exRe).join('|')) add('error', trRel, 1, 'pair-examples', '예시 ID(E1, E2, …)가 원문과 다릅니다');
      const qk = p.tables.filter((x) => x.section === 'questions').reduce((s, x) => s + x.rows.length, 0);
      const qt = tr.tables.filter((x) => x.section === 'questions').reduce((s, x) => s + x.rows.length, 0);
      if (qk !== qt) add('error', trRel, 1, 'pair-questions', `확인 요청 행 수가 원문(${qk})과 다릅니다(${qt})`);
      for (const mark of [PROPOSAL_MARK, PREPARE_MARK]) {
        const ck = countMarker(p, mark[cfg.primaryLanguage] || mark.ko);
        const ct = countMarker(tr, mark[t] || mark.en);
        if (ck !== ct) add('error', trRel, 1, 'pair-markers', `${mark[t] || mark.en} 개수(${ct})가 원문 ${mark[cfg.primaryLanguage] || mark.ko} 개수(${ck})와 다릅니다`);
      }
    }
  }
  for (const p of pages) {
    if (p.lang !== cfg.primaryLanguage && !get(p.slug)) add('error', relRoot(p.file), 1, 'translation-orphan', '원문 파일이 없는 번역입니다');
  }

  // 3. meta.json
  const dirs = new Set(pages.map((p) => path.dirname(p.file)));
  for (const dir of dirs) {
    const metaPath = path.join(dir, 'meta.json');
    const children = new Set();
    const dirSlug = toPosix(path.relative(cfg.docsAbs, dir));
    for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
      if (ent.isDirectory() && walk(path.join(dir, ent.name)).some((f) => /\.mdx?$/.test(f))) children.add(ent.name);
      else if (ent.isFile() && /\.mdx?$/.test(ent.name) && !cfg.translations.some((t) => new RegExp(`\\.${t}\\.mdx?$`).test(ent.name))) children.add(ent.name.replace(/\.mdx?$/, ''));
    }
    // 안내 페이지(guidePages)는 사이드바에서 빼도 된다(다른 페이지의 링크로 연다)
    const mayBeUnlisted = (name) => matchesList(dirSlug ? `${dirSlug}/${name}` : name, cfg.guidePages);
    if (!exists(metaPath)) {
      add('warn', relRoot(dir) + '/', 0, 'meta-missing', 'meta.json이 없습니다. 사이드바 순서를 정할 수 없습니다');
    } else {
      let meta;
      try {
        meta = JSON.parse(read(metaPath));
      } catch (e) {
        add('error', relRoot(metaPath), 1, 'meta-invalid', `JSON 오류: ${e.message}`);
        meta = null;
      }
      if (meta && Array.isArray(meta.pages)) {
        const listed = new Set();
        let rest = false;
        for (const entry of meta.pages) {
          if (typeof entry !== 'string') continue;
          if (entry.startsWith('---') || /^\[.*\]\(.*\)$/.test(entry)) continue;
          if (entry === '...' || entry === 'z...a') {
            rest = true;
            continue;
          }
          const name = entry.replace(/^(\.\.\.|!)/, '');
          listed.add(name);
          if (!children.has(name)) add('error', relRoot(metaPath), 1, 'meta-unknown-page', `pages의 "${entry}"에 해당하는 페이지나 폴더가 없습니다`);
        }
        if (!rest) for (const c of children) if (!listed.has(c) && !mayBeUnlisted(c)) add('warn', relRoot(metaPath), 1, 'meta-unlisted', `"${c}"가 pages에 없어 사이드바에 나오지 않습니다`);
      }
      for (const t of cfg.translations) {
        const tPath = path.join(dir, `meta.${t}.json`);
        if (!exists(tPath)) {
          add(cfg.requireTranslations ? 'warn' : 'info', relRoot(dir) + '/', 0, 'meta-translation-missing', `meta.${t}.json이 없습니다(폴더 제목 번역, title만 쓰면 된다)`);
          continue;
        }
        try {
          const tm = JSON.parse(read(tPath));
          if (Array.isArray(tm.pages) && meta && Array.isArray(meta.pages)) {
            const strip = (arr) => arr.filter((e) => typeof e === 'string' && !e.startsWith('---')).join('|');
            if (strip(tm.pages) !== strip(meta.pages)) add('warn', relRoot(tPath), 1, 'meta-translation-pages', `pages가 meta.json과 다릅니다. pages를 지우면 meta.json 순서를 따른다`);
          }
        } catch (e) {
          add('error', relRoot(tPath), 1, 'meta-invalid', `JSON 오류: ${e.message}`);
        }
      }
    }
  }

  // 4. 최상위 예약어
  if (exists(cfg.docsAbs)) {
    for (const ent of fs.readdirSync(cfg.docsAbs)) {
      const name = ent.replace(/(\.[a-z]{2})?\.mdx?$/, '');
      if (cfg.reservedTopLevelNames.includes(name)) add('error', `${docsRel}/${ent}`, 0, 'reserved-name', `최상위 이름 "${name}"은 사이트 주소(영어·예전 버전)에 쓰여 쓸 수 없습니다`);
    }
  }

  // 5. 링크, 제목·날짜 줄, 비밀값, 쓰지 않는 말
  const glossaryAvoid = {};
  for (const lang of cfg.langs) {
    const g = get(cfg.pages.glossary, lang);
    glossaryAvoid[lang] = [];
    if (!g) continue;
    for (const t of g.tables) {
      const avoidCol = columnIndex(t, /^(쓰지 않는 말|Avoid)$/i);
      if (avoidCol < 0) continue;
      for (const r of t.rows) {
        const term = (r.cells[0] || '').trim();
        for (const a of (r.cells[avoidCol] || '').split(/[,、]/).map((s) => s.trim()).filter(Boolean)) glossaryAvoid[lang].push([a, term]);
      }
    }
  }
  const allow = new Set(cfg.allowTerms || []);
  const termRes = {};
  for (const lang of cfg.langs) {
    const list = [];
    const base = BANNED_TERMS[lang] || BANNED_TERMS.en;
    const wb = lang === 'en';
    for (const [src, cat] of base) list.push({ re: new RegExp(wb ? `\\b${src}(?![\\w-])` : src, wb ? 'gi' : 'g'), cat, hint: TERM_HINT[cat] });
    if (lang === 'ko') for (const [src, repl] of PLAIN_WORDS_KO) list.push({ re: new RegExp(src, 'g'), cat: 'plain', hint: `고객사가 읽는 글에는 쉬운 말로 쓴다: "${repl}"`, customerOnly: true, code: 'term-plain' });
    for (const t of (cfg.terms && cfg.terms[lang]) || []) list.push({ re: new RegExp(wb ? `\\b${escapeRe(t)}\\b` : escapeRe(t), wb ? 'gi' : 'g'), cat: 'config', hint: TERM_HINT.config });
    for (const [a, term] of glossaryAvoid[lang] || []) list.push({ re: new RegExp(wb ? `\\b${escapeRe(a)}\\b` : escapeRe(a), wb ? 'gi' : 'g'), cat: 'glossary', hint: `용어집 용어 "${term}"을 쓴다`, glossary: true });
    termRes[lang] = list;
  }

  const assetsDir = cfg.assets && cfg.assets.dir ? path.resolve(cfg.root, cfg.assets.dir) : null;
  for (const p of pages) {
    const fileRel = relRoot(p.file);
    const internal = isInternal(p, cfg);
    const customer = (l) => !internal && l.n < p.devNotesFrom;
    const capped = (code, n, msg, total) => {
      total.count++;
      if (total.count <= 3) add('warn', fileRel, n, code, msg);
    };
    const tallies = { 'impl-detail': { count: 0 }, 'code-identifier': { count: 0 }, 'issue-ref': { count: 0 } };
    if (!internal) {
      for (const t of p.tables) {
        if (t.n >= p.devNotesFrom) continue;
        for (const h of t.header) if (PROGRESS_HEADER.test(h.replace(/`/g, '').trim())) add('warn', fileRel, t.n, 'progress-column', `고객사가 읽는 표에 진행 상태 열("${h}")이 있습니다. 진행 상태는 구현 상태 페이지에만 쓴다`);
      }
    }
    for (const l of p.raw.map((r, i) => ({ r, n: i + 1 }))) {
      for (const [re, what] of SECRET_PATTERNS) if (re.test(l.r)) add('error', fileRel, l.n, 'secret', `${what}로 보이는 값이 있습니다. SRS에는 위치와 항목 이름만 쓴다`);
    }
    for (const l of p.lines) {
      if (l.inFence) continue;
      if (/^#\s+\S/.test(l.code)) add('warn', fileRel, l.n, 'h1-in-body', '본문에 "# 제목"을 쓰지 않는다. 제목은 frontmatter title');
      if (MANUAL_DATE_LINE.test(l.text)) add('warn', fileRel, l.n, 'manual-date', '"최종 수정일" 줄을 쓰지 않는다. 날짜는 frontmatter version');
      const linkRe = /(!?)\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;
      let m;
      while ((m = linkRe.exec(l.text))) {
        const target = m[3];
        if (/^(https?:|mailto:|tel:|#)/.test(target)) continue;
        if (target.startsWith('/')) {
          if (assetsDir && cfg.assets.urlPrefix && target.startsWith(cfg.assets.urlPrefix)) {
            const f = path.join(assetsDir, decodeURI(target.slice(cfg.assets.urlPrefix.length)).split(/[?#]/)[0]);
            if (!exists(f)) add('error', fileRel, l.n, 'broken-asset', `이미지·파일이 없습니다: ${target}`);
          } else if ((cfg.docBasePaths || []).some((b) => target === b || target.startsWith(`${b}/`))) {
            add('warn', fileRel, l.n, 'absolute-doc-link', `문서 사이 링크는 상대 경로로 쓴다: ${target}`);
          }
          continue;
        }
        const clean = decodeURI(target.split(/[?#]/)[0]);
        if (!clean) continue;
        const abs = path.resolve(path.dirname(p.file), clean);
        const candidates = [abs, `${abs}.mdx`, `${abs}.md`, path.join(abs, 'index.mdx'), path.join(abs, 'index.md')];
        if (!candidates.some((c) => exists(c) && (fs.statSync(c).isFile() || c === abs && exists(path.join(c, 'index.mdx'))))) {
          add('error', fileRel, l.n, 'broken-link', `링크 대상이 없습니다: ${target}`);
        }
      }
      for (const t of termRes[p.lang] || []) {
        if (t.glossary && p.slug === cfg.pages.glossary) continue;
        if (t.customerOnly && (!customer(l) || p.slug === cfg.pages.glossary)) continue;
        if (/srs-ignore/.test(l.raw)) continue;
        t.re.lastIndex = 0;
        let tm;
        while ((tm = t.re.exec(l.text))) {
          if (allow.has(tm[0])) continue;
          add('warn', fileRel, l.n, t.code || (t.glossary ? 'term-glossary' : 'term-banned'), `"${tm[0]}": ${t.hint}`);
        }
      }
      if (/○○|\{\{[A-Z_]+\}\}/.test(l.code)) add('warn', fileRel, l.n, 'placeholder', '템플릿 자리 표시가 남아 있습니다');
      MARKER_MISSPELLING.lastIndex = 0;
      for (const mm of l.text.matchAll(MARKER_MISSPELLING)) add('error', fileRel, l.n, 'marker-spelling', `"${mm[0].slice(0, 40)}": 표시는 ${PROPOSAL_MARK.ko} ${PREPARE_MARK.ko} ${PROPOSAL_MARK.en} ${PREPARE_MARK.en} 그대로 쓴다(값은 표시 뒤에)`);
      // MDX는 { }를 코드로 읽는다. 컴포넌트 줄, import·export 줄 밖의 중괄호는 빌드를 깬다
      if (!/^\s*(<[A-Za-z/]|import\s|export\s)/.test(l.code) && /\{\{[A-Z_]+\}\}/.test(l.code) === false) {
        const bm = /(?<!\\)[{}]/.exec(l.text);
        if (bm) add('error', fileRel, l.n, 'mdx-brace', `중괄호가 있습니다("${l.text.slice(Math.max(0, bm.index - 15), bm.index + 15).trim()}"). MDX가 코드로 읽어 페이지가 깨진다. \\{ \\} 또는 \`…\`로 쓴다`);
      }
      if (customer(l)) {
        const im = IMPL_DETAIL.exec(l.code);
        if (im) capped('impl-detail', l.n, `고객사가 읽는 부분에 코드 경로가 있습니다("${im[1]}"). "개발 근거" 절로 옮긴다`, tallies['impl-detail']);
        const codeRe = /`([^`]+)`/g;
        let cm;
        while ((cm = codeRe.exec(l.code))) {
          if (CODE_IDENTIFIER.test(cm[1].trim())) capped('code-identifier', l.n, `고객사가 읽는 부분에 코드 이름("${cm[1]}")이 있습니다. 화면에 보이는 말로 쓴다`, tallies['code-identifier']);
        }
        const ir = ISSUE_REF.exec(l.text);
        if (ir && !/^\s*#/.test(l.code)) capped('issue-ref', l.n, `고객사가 읽는 부분에 이슈 번호("${ir[1] || ir[2]}")가 있습니다. 출처는 출처 ID로 단다`, tallies['issue-ref']);
      }
    }
    for (const [code, t] of Object.entries(tallies)) if (t.count > 3) add('warn', fileRel, 1, code, `같은 문제가 ${t.count - 3}곳 더 있습니다`);
  }

  // 6. 규칙, 양식, 확인
  const ruleOwner = new Map();
  const allRules = [];
  const noSourceTables = new Set();
  for (const p of primary) {
    const fileRel = relRoot(p.file);
    const rules = extractRules(p, cfg);
    const kind = formKind(p, cfg);
    if (p.fm.code && !new RegExp(cfg.codePattern).test(p.fm.code)) add('error', fileRel, 1, 'code-format', `code 형식(${cfg.codePattern})과 다릅니다: ${p.fm.code}`);
    for (const r of rules) {
      allRules.push({ ...r, page: p });
      if (ruleOwner.has(r.id)) add('error', fileRel, r.n, 'rule-duplicate', `규칙 ID ${r.id}가 ${relRoot(ruleOwner.get(r.id).file)}에도 있습니다`);
      else ruleOwner.set(r.id, p);
      if (p.fm.code && !r.id.startsWith(`${p.fm.code}-`)) add('warn', fileRel, r.n, 'rule-id-prefix', `규칙 ID ${r.id}가 이 페이지 code(${p.fm.code})로 시작하지 않습니다`);
      if (r.kind === 'table' && r.sources === null) {
        if (!noSourceTables.has(`${fileRel}:${r.tableLine}`)) add('warn', fileRel, r.tableLine, 'rule-table-no-source', '규칙 표에 "출처" 열이 없습니다');
        noSourceTables.add(`${fileRel}:${r.tableLine}`);
      } else if (r.kind === 'table') {
        const src = r.sources.trim();
        if (!src || /^[-—]$/.test(src)) add('warn', fileRel, r.n, 'rule-no-source', `${r.id}: 출처가 없습니다`);
      }
      // "~하면"에는 "아니면"
      const plain = r.text.replace(cfg.ruleIdGlobal, '').replace(cfg.sourceIdGlobal, '');
      const isKo = p.lang === 'ko';
      const cond = isKo ? /(하면|이면|되면|으면|라면|경우)/ : /\b(if|when|unless)\b/i;
      const other = isKo ? /(아니면|않으면|않는 경우|아닌 경우|그 외|외에는|나머지|그렇지 않|이 밖의)/ : /\b(otherwise|else|if not|in all other cases|in any other case)\b/i;
      if (kind && r.kind === 'table' && cond.test(plain) && !other.test(plain)) add('warn', fileRel, r.n, 'rule-if-without-else', `${r.id}: 조건("~하면")이 있는데 "아니면"이 없습니다`);
      // 숫자가 있는 규칙에는 예시
      const numeric = /\d/.test(plain.replace(PROPOSAL_MARK.ko, '').replace(/\d{4}-\d{2}-\d{2}/g, 'DATE'));
      if (kind && numeric) {
        const inExamples = p.lines.some((l) => l.section === 'examples' && l.code.includes(r.id));
        if (!inExamples) add('warn', fileRel, r.n, 'rule-no-example', `${r.id}: 숫자가 있는 규칙인데 예시 표에 이 규칙의 행이 없습니다`);
      }
    }
    if (!kind) continue;
    // 양식
    const present = new Set(p.headings.filter((h) => h.level === 2).map((h) => h.key));
    for (const key of REQUIRED_SECTIONS[kind] || []) if (!present.has(key)) add('warn', fileRel, 1, 'section-missing', `"${SECTION_LABEL[key]}" 절이 없습니다`);
    const status = p.fm.status;
    if (!status) add('warn', fileRel, 1, 'status-missing', 'frontmatter에 status(draft | in-review | confirmed)가 없습니다');
    else if (!STATUSES.includes(status)) add('error', fileRel, 1, 'status-invalid', `status는 draft | in-review | confirmed 중 하나다: ${status}`);
    if (!p.fm.code && rules.some((r) => r.kind === 'table')) add('warn', fileRel, 1, 'code-missing', 'frontmatter에 code(규칙 ID 접두어)가 없습니다');
    const proposals = countProposals(p, p.lang);
    const version = pageVersion(p, cfg);
    if (status === 'confirmed') {
      if (proposals > 0) add('error', fileRel, 1, 'confirmed-with-proposal', `확인됨 페이지에 ${PROPOSAL_MARK.ko}이 ${proposals}개 남아 있습니다`);
      const lc = lastConfirmedVersion(p);
      if (lc !== version) add('error', fileRel, 1, 'confirmed-without-record', `확인됨인데 현재 버전(${version})의 확인 기록이 없습니다${lc ? ` (마지막 확인: ${lc})` : ''}`);
    }
  }

  // 7. 출처 목록
  const sourcesPage = get(cfg.pages.sources);
  const sourceIds = new Set();
  if (!sourcesPage) add('error', docsRel, 0, 'sources-missing', `출처 목록 페이지(${cfg.pages.sources})가 없습니다`);
  else {
    const fileRel = relRoot(sourcesPage.file);
    let reflectTables = 0;
    for (const t of sourcesPage.tables) {
      const rCol = columnIndex(t, /(반영|Reflected|Used in)/i);
      if (rCol < 0) continue;
      reflectTables++;
      const idCol = columnIndex(t, /^(ID|출처 ID|Source ID)$/i);
      if (idCol < 0) add('warn', fileRel, t.n, 'source-no-id', '출처 표에 ID 열이 없습니다. 규칙의 "출처" 칸이 가리킬 수 없습니다');
      for (const r of t.rows) {
        const label = idCol >= 0 ? r.cells[idCol] : r.cells[0];
        if (idCol >= 0) {
          if (sourceIds.has(label)) add('error', fileRel, r.n, 'source-duplicate', `출처 ID ${label}가 중복됩니다`);
          sourceIds.add(label);
        }
        const cell = (r.cells[rCol] || '').trim();
        const rawCell = r.raw[rCol] || '';
        if (UNREAD_RE.test(cell)) add('warn', fileRel, r.n, 'source-unread', `${label}: 아직 읽지 않은 출처입니다. 읽고 반영 위치를 채운다(온보딩에서 넣은 출처)`);
        else if (!cell || /^([-—]|TBD|확인\s?필요|없음|미정)$/i.test(cell)) add('error', fileRel, r.n, 'source-unreflected', `${label}: 반영 위치가 비어 있습니다(반영할 내용이 없으면 "반영 없음: 이유")`);
        else if (/^(반영 없음|Not reflected)/i.test(cell)) {
          if (!/[:：]\s*\S/.test(cell)) add('warn', fileRel, r.n, 'source-no-reason', `${label}: "반영 없음" 뒤에 이유를 쓴다`);
        } else if (!/\]\(/.test(rawCell)) add('warn', fileRel, r.n, 'source-no-link', `${label}: 반영 위치에 페이지 링크가 없습니다`);
      }
    }
    if (!reflectTables) add('error', fileRel, 1, 'sources-no-table', '"반영 위치" 열이 있는 출처 표가 없습니다');
    // 규칙이 가리키는 출처 ID
    for (const r of allRules) {
      if (!r.sources) continue;
      cfg.sourceIdGlobal.lastIndex = 0;
      for (const id of r.sources.match(cfg.sourceIdGlobal) || []) {
        if (!sourceIds.has(id)) add('error', relRoot(r.page.file), r.n, 'rule-unknown-source', `${r.id}: 출처 ${id}가 출처 목록에 없습니다`);
      }
    }
  }

  // 7-1. 근거 파일 보관함: 사본이 git에 올라가지 않았는지, 넣은 뒤 원본이 바뀌지 않았는지
  const vault = vaultDir(cfg);
  if (exists(vault)) {
    const vrel = toPosix(path.relative(cfg.root, vault));
    const tracked = git(cfg, ['-c', 'core.quotePath=false', 'ls-files', '--', vrel], { allowFail: true });
    for (const f of (tracked || '').split('\n').map((x) => x.trim()).filter(Boolean)) {
      if (/(^|\/)(\.gitignore|manifest\.json)$/.test(f)) continue;
      add('error', f, 0, 'source-copy-tracked', `근거 파일 사본이 git에 올라가 있습니다. git rm --cached "${f}" 후 커밋한다(보관함의 .gitignore가 막지만 강제로 추가된 것)`);
    }
    if (!exists(path.join(vault, '.gitignore'))) add('error', vrel + '/', 0, 'source-vault-unignored', '보관함에 .gitignore가 없습니다. srs source add나 srs source refresh를 한 번 실행하면 다시 만든다');
    for (const st of sourceStatuses(cfg)) {
      if (st.state === 'changed') add('warn', `${vrel}/manifest.json`, 0, 'source-changed', `${st.id}: ${st.detail}. 다시 읽고 SRS에 반영한 뒤 srs source refresh ${st.id}`);
      else if (st.state === 'missing') add('info', `${vrel}/manifest.json`, 0, 'source-missing-here', `${st.id}: ${st.detail}`);
    }
  }

  // 8. 추적표
  const tracePage = get(cfg.pages.traceability);
  if (!tracePage) add('warn', docsRel, 0, 'trace-missing-page', `추적표 페이지(${cfg.pages.traceability})가 없습니다`);
  else {
    const traceIds = new Map();
    const fileRel = relRoot(tracePage.file);
    for (const t of tracePage.tables) {
      if (!/ID/i.test(t.header[0] || '')) continue;
      const implCol = columnIndex(t, IMPL_COL);
      for (const r of t.rows) {
        const id = (r.cells[0] || '').trim();
        if (!cfg.ruleIdRe.test(id)) continue;
        traceIds.set(id, r.n);
        // srs sync impl이 세는 말만 쓴다(PROCESS 3단계)
        if (implCol >= 0 && implStateOf(r.cells[implCol]) === undefined) add('warn', fileRel, r.n, 'trace-impl-state', `${id}의 구현 상태가 정해진 말이 아닙니다("${(r.cells[implCol] || '').trim()}"). 쓸 말: 구현됨 / 다르게 구현됨 / 미구현 / 범위에서 빠짐`);
      }
    }
    for (const r of allRules) if (!traceIds.has(r.id)) add('warn', relRoot(r.page.file), r.n, 'trace-missing', `${r.id}가 추적표에 없습니다`);
    for (const [id, n] of traceIds) if (!ruleOwner.has(id)) add('warn', fileRel, n, 'trace-unknown', `추적표의 ${id}를 정의한 페이지가 없습니다`);
  }

  // 9. 예전 버전
  for (const f of walk(cfg.versionsAbs)) {
    const relV = toPosix(path.relative(cfg.versionsAbs, f));
    const parts = relV.split('/');
    const fileRel = relRoot(f);
    if (!isDate(parts[0])) {
      add('error', fileRel, 0, 'snapshot-folder', `예전 버전 폴더 이름이 YYYY-MM-DD가 아닙니다: ${parts[0]}`);
      continue;
    }
    if (parts.length < 2 || !/\.mdx?$/.test(f)) continue;
    const date = parts[0];
    const relPage = parts.slice(1).join('/');
    let lang = cfg.primaryLanguage;
    let slug = relPage.replace(/\.mdx?$/, '');
    for (const t of cfg.translations) if (new RegExp(`\\.${t}\\.mdx?$`).test(relPage)) {
      lang = t;
      slug = relPage.replace(new RegExp(`\\.${t}\\.mdx?$`), '');
    }
    const cur = get(slug, lang);
    if (!cur) {
      add('info', fileRel, 0, 'snapshot-orphan', '현재 페이지가 없는 예전 버전입니다(사이트에 나오지 않음)');
      continue;
    }
    const cv = pageVersion(cur, cfg);
    if (!cv || !isDate(cv)) continue;
    if (date > cv) add('error', fileRel, 0, 'snapshot-newer', `예전 버전 날짜(${date})가 현재 버전(${cv})보다 늦습니다`);
    else if (date === cv && read(f) !== cur.text) add('warn', relRoot(cur.file), 1, 'edited-without-bump', `현재 버전(${cv})과 같은 날짜의 예전 버전과 내용이 다릅니다. 고치기 전에 srs bump를 하지 않은 것으로 보입니다`);
  }

  // 10. 기준 커밋과 비교(--base): 버전을 올린 페이지는 versionNote가 바뀌고, 기준 커밋의 파일이 그대로 예전 버전에 있다
  if (opt.base) {
    checkBaseRef(cfg, opt.base);
    for (const p of pages) {
      const old = gitShow(cfg, opt.base, p.file);
      if (old === null) continue;
      const ofm = analyzeText(old).fm;
      const ov = ofm.version || cfg.legacyVersion;
      const nv = pageVersion(p, cfg);
      const fileRel = relRoot(p.file);
      if (!ov || !isDate(ov) || ov === nv) {
        if (old !== p.text && ov === nv && !isGenerated(p.slug, cfg)) add('info', fileRel, 1, 'changed-same-version', `${opt.base} 뒤 내용이 바뀌었는데 version(${nv})이 같습니다. 개발 근거·번호·링크 글자만 바뀐 것이 아니면 버전을 올린다`);
        continue;
      }
      if ((ofm.versionNote || '') === (p.fm.versionNote || '')) add('error', fileRel, 1, 'version-note-unchanged', `version이 ${ov} → ${nv}로 바뀌었는데 versionNote가 그대로입니다`);
      if (isGenerated(p.slug, cfg)) continue;
      const arc = path.join(cfg.versionsAbs, ov, path.relative(cfg.docsAbs, p.file));
      if (!exists(arc)) add('error', fileRel, 1, 'archive-missing', `예전 버전이 없습니다: ${relRoot(arc)} (${opt.base}의 파일을 그대로 남긴다)`);
      else if (read(arc) !== old) add('error', relRoot(arc), 1, 'archive-differs', `예전 버전이 ${opt.base}의 파일과 다릅니다`);
    }
  }

  // 11. 페이지 번호(numbering.enabled)
  const numRe = /^(\d+(?:\.\d+)*)\.?(?=\s|$)/;
  const titleNum = (pg) => (pg && numRe.exec(pg.fm.title || '') || [])[1] || null;
  const stripNum = (s) => (s || '').replace(numRe, '').trim();
  if (cfg.numbering && cfg.numbering.enabled) {
    const indexSlug = cfg.numbering.indexPage || 'index';
    for (const lang of cfg.langs) {
      const idx = get(indexSlug, lang);
      if (!idx) continue;
      const listedTop = new Set();
      for (const t of idx.tables) {
        for (const r of t.rows) {
          const n = (r.cells[0] || '').trim();
          const lm = /\[([^\]]+)\]\(([^)\s#]+)/.exec(r.raw.join('|'));
          if (!/^\d+(\.\d+)*$/.test(n) || !lm) continue;
          const target = resolveDocLink(idx, lm[2], cfg, get);
          if (!target) continue;
          listedTop.add(target.slug.split('/')[0]);
          if (titleNum(target) !== n) add('warn', relRoot(idx.file), r.n, 'number-index', `표 번호 ${n}인데 페이지 제목은 "${target.fm.title}"입니다`);
        }
      }
      if (lang !== cfg.primaryLanguage) continue;
      for (const p of primary) {
        const top = p.slug.split('/')[0];
        if (p.slug === indexSlug || p.slug.includes('/') && !p.slug.endsWith('/index') || isInternal(p, cfg)) continue;
        if (!listedTop.has(top)) add('warn', relRoot(p.file), 1, 'number-not-in-index', `개요 페이지 표에 이 페이지(번호)가 없습니다`);
      }
    }
    for (const dir of new Set(primary.map((p) => path.dirname(p.file)))) {
      const metaPath = path.join(dir, 'meta.json');
      if (!exists(metaPath)) continue;
      let meta;
      try {
        meta = JSON.parse(read(metaPath));
      } catch {
        continue;
      }
      const relDir = toPosix(path.relative(cfg.docsAbs, dir));
      let prev = null;
      for (const entry of meta.pages || []) {
        if (typeof entry !== 'string' || entry.startsWith('---')) continue;
        const slug = relDir ? `${relDir}/${entry}` : entry;
        const n = titleNum(get(slug) || get(`${slug}/index`));
        if (!n) continue;
        const key = n.split('.').map(Number);
        if (prev && compareNum(key, prev.key) < 0) add('warn', relRoot(metaPath), 1, 'number-order', `"${entry}"(${n})가 "${prev.entry}"(${prev.n}) 뒤에 있습니다. 사이드바는 번호 순서로`);
        prev = { key, n, entry };
      }
    }
  }

  // 12. 링크 글자 = 대상 페이지 제목(linkText: "title")
  if (cfg.linkText === 'title') {
    const allowed = new Set(cfg.linkTextAllow || []);
    for (const p of pages) {
      const tally = new Map();
      for (const l of p.lines) {
        if (l.inFence) continue;
        for (const m of l.text.matchAll(/(?<!!)\[([^\]]+)\]\(([^)\s]+)\)/g)) {
          const target = resolveDocLink(p, m[2], cfg, get);
          if (!target || !target.fm.title) continue;
          const txt = m[1].trim();
          if (allowed.has(txt) || cfg.ruleIdRe.test(txt) || /^[\d.]+$/.test(txt)) continue;
          if (txt === target.fm.title || stripNum(txt) === stripNum(target.fm.title)) continue;
          const k = `${txt} → ${target.fm.title}`;
          if (!tally.has(k)) tally.set(k, { n: l.n, c: 0 });
          tally.get(k).c++;
        }
      }
      for (const [k, v] of tally) add('warn', relRoot(p.file), v.n, 'link-text', `링크 글자가 페이지 제목과 다릅니다: ${k}${v.c > 1 ? ` (${v.c}곳)` : ''}. srs sync links로 맞춘다`);
    }
  }

  return { findings, pages, primary, allRules, sourceIds };
}

function compareNum(a, b) {
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    const d = (a[i] ?? -1) - (b[i] ?? -1);
    if (d) return d;
  }
  return 0;
}

// 상대 링크가 가리키는 같은 언어의 페이지(없으면 원문 페이지). 페이지가 아니면 null
function resolveDocLink(page, href, cfg, get) {
  if (/^(https?:|mailto:|tel:|#|\/)/.test(href)) return null;
  const clean = decodeURI(href.split(/[?#]/)[0]).replace(/\.mdx?$/, '');
  if (!clean) return null;
  const slug = path.posix.normalize(path.posix.join(path.posix.dirname(page.slug), clean)).replace(/\/$/, '');
  if (slug.startsWith('..')) return null;
  return get(slug, page.lang) || get(`${slug}/index`, page.lang) || get(slug) || get(`${slug}/index`) || null;
}

function printCheck(result, cfg, opt) {
  const { findings, pages, primary, allRules, sourceIds } = result;
  const levels = { error: 0, warn: 0, info: 0 };
  for (const f of findings) levels[f.level]++;
  if (opt.json) {
    process.stdout.write(`${JSON.stringify({ root: cfg.root, summary: levels, findings, ...(result.baseline ? { baseline: result.baseline } : {}) }, null, 2)}\n`);
    return levels;
  }
  const show = findings.filter((f) => f.level !== 'info' || opt.verbose);
  const byFile = new Map();
  for (const f of show) {
    if (!byFile.has(f.file)) byFile.set(f.file, []);
    byFile.get(f.file).push(f);
  }
  const limit = opt.verbose ? Infinity : Number(opt.limit || 5);
  const mark = { error: '오류', warn: '경고', info: '참고' };
  const out = [];
  for (const file of [...byFile.keys()].sort()) {
    out.push(file);
    const list = byFile.get(file).sort((a, b) => (a.line || 0) - (b.line || 0));
    const perCode = new Map();
    for (const f of list) {
      const c = perCode.get(f.code) || 0;
      perCode.set(f.code, c + 1);
      if (c < limit) out.push(`  ${String(f.line || '-').padStart(4)}  ${mark[f.level]}  [${f.code}] ${f.msg}`);
    }
    for (const [code, c] of perCode) if (c > limit) out.push(`        ...  [${code}] ${c - limit}건 더 (--verbose로 모두 보기)`);
  }
  const codeCount = new Map();
  for (const f of findings) {
    const k = `${f.level}:${f.code}`;
    codeCount.set(k, (codeCount.get(k) || 0) + 1);
  }
  out.push('');
  out.push(`검사: ${shown(cfg.docsAbs) || '.'} (설정: ${cfg.configPath ? shown(cfg.configPath) : '기본값'})`);
  out.push(`페이지 ${primary.length}개(번역 포함 ${pages.length}개), 규칙 ID ${allRules.length}개, 출처 ID ${sourceIds.size}개`);
  const order = { error: 0, warn: 1, info: 2 };
  const rows = [...codeCount.entries()].sort((a, b) => order[a[0].split(':')[0]] - order[b[0].split(':')[0]] || b[1] - a[1]);
  for (const [k, c] of rows) {
    const [lv, code] = k.split(':');
    out.push(`  ${mark[lv]} ${String(c).padStart(4)}  ${code}`);
  }
  const b = result.baseline;
  if (b) {
    out.push(`기준선: ${b.file} (${b.saved || '날짜 없음'}) — 그때 있던 ${b.hidden}건은 숨김, 아래는 그 뒤에 생긴 것`);
    if (b.gone) out.push(`  기준선에 있던 ${b.gone}건이 없어졌다. srs check --save-baseline으로 다시 저장하면 기준선이 줄어든다`);
  }
  out.push(`결과: 오류 ${levels.error}, 경고 ${levels.warn}${levels.info ? `, 참고 ${levels.info}` : ''}`);
  process.stdout.write(`${out.join('\n')}\n`);
  return levels;
}

// 기준선: 기존 SRS를 처음 검사하면 오류·경고가 많다. 지금 결과를 남겨 두고 그 뒤에 생긴 것만 본다.
// 줄 번호는 바뀌기 쉬워서 열쇠에 넣지 않는다(파일·코드·메시지가 같으면 같은 것).
const baselineKey = (f) => [f.level, f.file, f.code, f.msg].join('\t');

function baselinePath(cfg) {
  return path.resolve(cfg.root, cfg.checkBaseline);
}

function saveCheckBaseline(cfg, result) {
  const counts = {};
  const levels = { error: 0, warn: 0 };
  for (const f of result.findings) {
    if (!(f.level in levels)) continue;
    levels[f.level]++;
    const k = baselineKey(f);
    counts[k] = (counts[k] || 0) + 1;
  }
  const file = baselinePath(cfg);
  fs.writeFileSync(file, `${JSON.stringify({ saved: today(), summary: levels, counts }, null, 2)}\n`);
  process.stdout.write(`기준선 저장: ${shown(file)} (오류 ${levels.error}, 경고 ${levels.warn})\n이제 srs check --baseline은 이 뒤에 생긴 것만 보여 준다. 이 파일은 커밋해 팀이 같이 쓴다.\n`);
}

function applyCheckBaseline(cfg, result) {
  const file = baselinePath(cfg);
  if (!exists(file)) die(`기준선 파일이 없습니다: ${shown(file)}. srs check --save-baseline으로 먼저 만든다`);
  let saved;
  try {
    saved = JSON.parse(read(file));
  } catch (e) {
    die(`${shown(file)}: JSON을 읽을 수 없습니다 (${e.message})`);
  }
  const left = { ...(saved.counts || {}) };
  let hidden = 0;
  result.findings = result.findings.filter((f) => {
    const k = baselineKey(f);
    if (!left[k]) return true;
    left[k]--;
    hidden++;
    return false;
  });
  const gone = Object.values(left).reduce((a, n) => a + n, 0);
  result.baseline = { file: shown(file), saved: saved.saved || null, hidden, gone };
}

// ---------------------------------------------------------------- status

function runStatus(cfg, opt) {
  const { pages, get } = loadPages(cfg);
  const primary = pages.filter((p) => p.lang === cfg.primaryLanguage).sort((a, b) => a.slug.localeCompare(b.slug));
  const rows = [];
  const counts = { draft: 0, 'in-review': 0, confirmed: 0, recheck: 0 };
  for (const p of primary) {
    const kind = formKind(p, cfg);
    const rules = extractRules(p, cfg);
    if (!kind && !rules.length && !opt.all) continue;
    const v = pageVersion(p, cfg) || '-';
    const tr = cfg.translations.map((t) => {
      const tp = get(p.slug, t);
      if (!tp) return '없음';
      const tv = pageVersion(tp, cfg);
      return tv === v ? '같음' : `${tv} (뒤처짐)`;
    });
    const status = p.fm.status || '-';
    const lc = lastConfirmedVersion(p);
    if (counts[status] !== undefined) counts[status]++;
    if (status === 'confirmed' && lc !== v) counts.recheck++;
    rows.push([`[${p.fm.title || p.slug}](${relLink(p.slug)})`, p.slug, v, ...tr, status, String(countProposals(p, p.lang)), lc || '-', String(rules.length)]);
  }
  const header = ['페이지', '경로', '버전', ...cfg.translations.map((t) => `번역(${t})`), '상태', '(제안)', '마지막 확인', '규칙'];
  const out = [];
  out.push(`기준일: ${opt.date || today()}`);
  out.push('');
  out.push(`| ${header.join(' | ')} |`);
  out.push(`| ${header.map(() => '---').join(' | ')} |`);
  for (const r of rows) out.push(`| ${r.join(' | ')} |`);
  out.push('');
  out.push(`작성 중 ${counts.draft}, 확인 중 ${counts['in-review']}, 확인됨 ${counts.confirmed}${counts.recheck ? ` (그중 현재 버전 확인 기록 없음 ${counts.recheck})` : ''}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

function relLink(slug) {
  // confirmations 페이지(baseline/)에 붙여 넣는 것을 기준으로 한 상대 링크
  return `../${slug.replace(/\/index$/, '')}`;
}

// ---------------------------------------------------------------- frontmatter 쓰기

function setFrontmatter(text, updates) {
  const nl = text.includes('\r\n') ? '\r\n' : '\n';
  const lines = text.split(/\r?\n/);
  let end = -1;
  if (lines[0] === '---') end = lines.indexOf('---', 1);
  if (end < 0) {
    lines.unshift('---', '---');
    end = 1;
  }
  for (const [key, value] of Object.entries(updates)) {
    const idx = lines.slice(1, end).findIndex((l) => new RegExp(`^${key}\\s*:`).test(l));
    if (value === null) {
      if (idx >= 0) {
        lines.splice(idx + 1, 1);
        end--;
      }
      continue;
    }
    const line = `${key}: ${value}`;
    if (idx >= 0) lines[idx + 1] = line;
    else {
      lines.splice(end, 0, line);
      end++;
    }
  }
  return lines.join(nl);
}

const yamlString = (s) => JSON.stringify(String(s));

// ---------------------------------------------------------------- bump

function resolvePageArg(arg, cfg) {
  if (!arg) die('페이지를 주세요. 예: srs bump features/order-cancellation');
  let p = arg.replace(/\\/g, '/');
  const abs = path.resolve(process.cwd(), p);
  if (exists(abs) && abs.startsWith(cfg.docsAbs)) p = toPosix(path.relative(cfg.docsAbs, abs));
  p = p.replace(/^\.?\/?/, '').replace(new RegExp(`^${escapeRe(cfg.docsDir.replace(/\/$/, ''))}/`), '');
  let lang = null;
  for (const t of cfg.translations) if (new RegExp(`\\.${t}\\.mdx?$`).test(p)) {
    lang = t;
    p = p.replace(new RegExp(`\\.${t}\\.mdx?$`), '');
  }
  p = p.replace(/\.mdx?$/, '').replace(/\/$/, '');
  const fileFor = (l) => {
    for (const ext of ['.mdx', '.md']) {
      const f = path.join(cfg.docsAbs, l === cfg.primaryLanguage ? `${p}${ext}` : `${p}.${l}${ext}`);
      if (exists(f)) return f;
      const idx = path.join(cfg.docsAbs, p, l === cfg.primaryLanguage ? `index${ext}` : `index.${l}${ext}`);
      if (exists(idx)) return idx;
    }
    return null;
  };
  return { slug: p, lang, fileFor };
}

function snapshot(file, version, cfg, opt, log) {
  const rel = path.relative(cfg.docsAbs, file);
  if (isGenerated(analyzePage(file, cfg).slug, cfg)) {
    log.push(`  판마다 다시 만드는 표라 예전 버전을 남기지 않음: ${toPosix(rel)}`);
    return true;
  }
  const dest = path.join(cfg.versionsAbs, version, rel);
  const relDest = toPosix(path.relative(cfg.root, dest));
  if (exists(dest)) {
    if (read(dest) === read(file)) {
      log.push(`  이미 있음(같은 내용): ${relDest}`);
      return true;
    }
    if (!opt.force) die(`${relDest}가 이미 있고 현재 파일과 내용이 다릅니다. 예전 버전 파일은 고치지 않는다. 확인 후 --force로 덮어쓴다`);
  }
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.copyFileSync(file, dest);
  log.push(`  예전 버전 저장: ${relDest}`);
  return true;
}

// 판 단위로 올린다: 기준 커밋 뒤 바뀐 페이지를 모두 같은 날짜로, 한·영 함께.
// 고친 뒤에 실행한다. 예전 버전에는 기준 커밋의 파일을 남긴다.
function runEditionBump(cfg, opt) {
  if (!opt.base) die('--edition에는 --base <기준 커밋>이 필요하다(판을 시작한 커밋. 예: origin/dev)');
  checkBaseRef(cfg, opt.base);
  const date = opt.date || today();
  if (!isDate(date)) die(`--date 형식이 YYYY-MM-DD가 아닙니다: ${date}`);
  if (!opt.note) die('--note "이번 판에서 바뀐 것 한 줄"이 필요하다');
  const dry = Boolean(opt['dry-run']);
  const slugs = new Set();
  for (const f of changedDocFiles(cfg, opt.base)) {
    if (!exists(f)) continue;
    const pg = analyzePage(f, cfg);
    slugs.add(pg.slug);
  }
  if (!slugs.size) {
    process.stdout.write(`${opt.base} 뒤 바뀐 페이지가 없습니다\n`);
    return;
  }
  const out = [];
  const counts = { bumped: 0, archived: 0, same: 0 };
  for (const slug of [...slugs].sort()) {
    const { fileFor } = resolvePageArg(slug, cfg);
    for (const lang of cfg.langs) {
      const file = fileFor(lang);
      if (!file) continue;
      const rel = toPosix(path.relative(cfg.root, file));
      const text = read(file);
      const fm = analyzeText(text).fm;
      if (fm.version === date) {
        counts.same++;
        out.push(`  = ${rel}: 이미 ${date}`);
        continue;
      }
      const old = gitShow(cfg, opt.base, file);
      const oldVersion = old === null ? null : analyzeText(old).fm.version || cfg.legacyVersion;
      if (oldVersion && isDate(oldVersion) && oldVersion > date) die(`${rel}: 기준 커밋의 version(${oldVersion})이 새 판(${date})보다 늦다`);
      if (old !== null && oldVersion && isDate(oldVersion) && oldVersion !== date && !isGenerated(slug, cfg)) {
        const dest = path.join(cfg.versionsAbs, oldVersion, path.relative(cfg.docsAbs, file));
        const relDest = toPosix(path.relative(cfg.root, dest));
        if (exists(dest) && read(dest) !== old && !opt.force) die(`${relDest}가 이미 있고 ${opt.base}의 파일과 다르다. 예전 버전 파일은 고치지 않는다. 확인 후 --force`);
        if (!dry && !(exists(dest) && read(dest) === old)) {
          fs.mkdirSync(path.dirname(dest), { recursive: true });
          fs.writeFileSync(dest, old);
        }
        counts.archived++;
        out.push(`  예전 버전 저장: ${relDest}`);
      }
      const note = lang === cfg.primaryLanguage ? opt.note : opt[`note-${lang}`] || opt.note;
      const updates = { version: yamlString(date), versionNote: yamlString(note) };
      if (fm.status === 'confirmed') updates.status = 'draft';
      if (!dry) fs.writeFileSync(file, setFrontmatter(text, updates));
      counts.bumped++;
      out.push(`  ${rel}: version ${fm.version || '(없음)'} → ${date}${updates.status ? ', status confirmed → draft' : ''}`);
    }
  }
  out.push('');
  out.push(`${dry ? '(미리 보기) ' : ''}판 ${date}: 페이지 ${slugs.size}개, 파일 ${counts.bumped}개 올림, 예전 버전 ${counts.archived}개 저장${counts.same ? `, 이미 ${date} ${counts.same}개` : ''}`);
  if (cfg.translations.some((t) => !opt[`note-${t}`])) out.push(`번역 versionNote는 --note를 그대로 썼다. 번역 문장으로 고친다(--note-${cfg.translations[0]}로 줄 수 있다)`);
  out.push(`다음: srs check --base ${opt.base}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

function runBump(cfg, pos, opt) {
  if (opt.edition) return runEditionBump(cfg, opt);
  const { slug, lang: fileLang, fileFor } = resolvePageArg(pos[0], cfg);
  const lang = opt.lang || fileLang || cfg.primaryLanguage;
  if (lang !== 'all' && !cfg.langs.includes(lang)) die(`--lang은 ${cfg.langs.join(', ')}, all 중 하나다`);
  const primaryFile = fileFor(cfg.primaryLanguage);
  if (!primaryFile) die(`페이지가 없습니다: ${cfg.docsDir}/${slug}.mdx`);
  const log = [];
  const primaryText = read(primaryFile);
  const pfm = analyzeText(primaryText).fm;
  if (pfm.version && opt.from && opt.from !== pfm.version) die(`--from은 version이 없는 파일에만 쓴다(지금 version: ${pfm.version})`);
  const oldVersion = pfm.version || opt.from || cfg.legacyVersion;
  if (!oldVersion) die(`${toPosix(path.relative(cfg.root, primaryFile))}에 version이 없습니다. 지금 내용의 날짜를 --from YYYY-MM-DD로 주거나 srs.config.json에 legacyVersion을 둔다`);
  if (!isDate(oldVersion)) die(`지금 version 형식이 YYYY-MM-DD가 아닙니다: ${oldVersion}`);

  const bumpTranslation = (t, target) => {
    const tf = fileFor(t);
    if (!tf) {
      log.push(`  ${t} 파일 없음: 번역을 만들면 version을 ${target}로 둔다`);
      return;
    }
    const tfm = analyzeText(read(tf)).fm;
    const tv = tfm.version || cfg.legacyVersion;
    if (tv === target) {
      log.push(`  ${t}: 이미 ${target}`);
      return;
    }
    if (tv && isDate(tv)) snapshot(tf, tv, cfg, opt, log);
    const updates = { version: yamlString(target) };
    if (opt['note-en'] || (opt.note && t !== cfg.primaryLanguage && lang === t)) updates.versionNote = yamlString(opt['note-en'] || opt.note);
    else updates.versionNote = null;
    fs.writeFileSync(tf, setFrontmatter(read(tf), updates));
    log.push(`  ${t}: version ${tv || '(없음)'} → ${target}`);
  };

  if (lang !== 'all' && lang !== cfg.primaryLanguage) {
    // 번역을 원문 버전에 맞춘다
    if (opt.date && opt.date !== oldVersion) die(`번역 version은 원문 version(${oldVersion})과 같아야 한다. --date는 쓰지 않는다`);
    bumpTranslation(lang, oldVersion);
    process.stdout.write(`${slug} (${lang})\n${log.join('\n')}\n`);
    return;
  }

  const newVersion = opt.date || today();
  if (!isDate(newVersion)) die(`--date 형식이 YYYY-MM-DD가 아닙니다: ${newVersion}`);
  if (newVersion === oldVersion) {
    if (pfm.version) {
      process.stdout.write(`${slug}: 이미 ${newVersion} 버전이다. 같은 날 고치는 것은 bump 없이 그대로 고친다\n`);
      return;
    }
    // version 없이 기준 버전으로 보던 파일: 같은 버전이므로 예전 버전을 만들지 않고 version만 적는다
    fs.writeFileSync(primaryFile, setFrontmatter(primaryText, { version: yamlString(newVersion) }));
    process.stdout.write(`${slug}: version이 없어 ${oldVersion}로 보던 파일이다. 같은 버전이므로 version: "${newVersion}"만 적었다\n`);
    return;
  }
  if (newVersion < oldVersion) die(`새 버전(${newVersion})이 지금 버전(${oldVersion})보다 이르다`);

  snapshot(primaryFile, oldVersion, cfg, opt, log);
  // 번역도 자기 version 폴더에 남긴다(이미 있으면 건너뜀). version은 번역을 마친 뒤 --lang으로 맞춘다.
  for (const t of cfg.translations) {
    const tf = fileFor(t);
    if (!tf) continue;
    const tv = analyzeText(read(tf)).fm.version || cfg.legacyVersion;
    if (tv && isDate(tv)) snapshot(tf, tv, cfg, opt, log);
  }
  const updates = { version: yamlString(newVersion), versionNote: opt.note ? yamlString(opt.note) : null };
  const wasConfirmed = pfm.status === 'confirmed';
  if (wasConfirmed) updates.status = 'draft';
  fs.writeFileSync(primaryFile, setFrontmatter(primaryText, updates));
  log.push(`  ${cfg.primaryLanguage}: version ${pfm.version || `(없음, ${oldVersion}로 봄)`} → ${newVersion}`);
  if (wasConfirmed) log.push('  status: confirmed → draft (고객사 확인을 다시 받는다. 확인 기록에 새 버전 행을 넣은 뒤 confirmed로)');
  if (!opt.note) log.push('  versionNote를 지웠다. --note "바뀐 것 한 줄"로 남기는 것을 권장');
  if (lang === 'all') for (const t of cfg.translations) bumpTranslation(t, newVersion);
  else if (cfg.translations.length) log.push(`  번역은 그대로 두었다. 번역을 고친 뒤: srs bump ${slug} --lang ${cfg.translations[0]}`);
  process.stdout.write(`${slug}\n${log.join('\n')}\n`);
}

// ---------------------------------------------------------------- sync

const plainText = (s) => (s || '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/`/g, '').replace(/\\/g, '').replace(/\s+/g, ' ').trim();
const cellOut = (s) => String(s).replace(/\|/g, '\\|');

function writePage(page, raw, dry) {
  if (dry) return;
  const nl = page.text.includes('\r\n') ? '\r\n' : '\n';
  fs.writeFileSync(page.file, raw.join(nl));
}

// 추적표의 규칙 행을 페이지의 규칙에 맞춘다: 빠진 행을 넣고, 출처·요약 칸을 고친다. 다른 칸은 두고, 없어진 규칙 행은 알리기만 한다.
function runSyncTrace(cfg, opt) {
  const { pages, get } = loadPages(cfg);
  const dry = Boolean(opt['dry-run']);
  const limit = Number(cfg.traceSummaryLength) || 80;
  const cut = (t) => {
    const s = plainText(t);
    return s.length > limit ? `${s.slice(0, limit).trimEnd()}…` : s;
  };
  const out = [];
  for (const lang of cfg.langs) {
    const tp = get(cfg.pages.traceability, lang);
    if (!tp) continue;
    const table = tp.tables.find((t) => /ID/i.test(t.header[0] || ''));
    if (!table) {
      out.push(`${toPosix(path.relative(cfg.root, tp.file))}: 첫 열이 ID인 표가 없습니다`);
      continue;
    }
    const pageCol = columnIndex(table, /^(페이지|Page)$/i);
    const srcCol = columnIndex(table, /^(출처|근거|Sources?)$/i);
    const sumCol = columnIndex(table, /^(규칙|요약|규칙 요약|Rule|Rule summary|Summary)$/i);
    const raw = [...tp.raw];
    const rowIndex = new Map(); // id -> raw 줄 번호(0부터)
    for (const r of table.rows) {
      const id = (r.cells[0] || '').trim();
      if (cfg.ruleIdRe.test(id)) rowIndex.set(id, r.n - 1);
    }
    let lastRow = table.rows.length ? table.rows[table.rows.length - 1].n - 1 : table.n; // 구분 줄 다음에 넣는다
    const defined = new Set();
    const changes = [];
    const langPages = pages.filter((p) => p.lang === lang && !isInternal(p, cfg) && p.slug !== cfg.pages.traceability).sort((a, b) => a.slug.localeCompare(b.slug));
    for (const p of langPages) {
      const rules = extractRules(p, cfg);
      if (!rules.length) continue;
      let rel = path.posix.relative(path.posix.dirname(cfg.pages.traceability), p.slug.replace(/\/index$/, ''));
      if (!rel.startsWith('.')) rel = `./${rel}`;
      const pageLink = `[${p.fm.title || p.slug}](${rel})`;
      let anchor = null;
      for (const r of rules) {
        defined.add(r.id);
        if (rowIndex.has(r.id)) {
          const i = rowIndex.get(r.id);
          anchor = i;
          const cells = splitCells(raw[i]);
          while (cells.length < table.header.length) cells.push('');
          let touched = false;
          if (srcCol >= 0 && r.sources !== null && cells[srcCol] !== r.sources.trim()) {
            cells[srcCol] = r.sources.trim();
            touched = true;
          }
          if (sumCol >= 0) {
            const short = plainText(cells[sumCol]).replace(/…$/, '').trim();
            if (!short || !plainText(r.text).startsWith(short)) {
              cells[sumCol] = cut(r.text);
              touched = true;
            }
          }
          if (pageCol >= 0 && !cells[pageCol].trim()) {
            cells[pageCol] = pageLink;
            touched = true;
          }
          if (touched) {
            raw[i] = `| ${cells.map(cellOut).join(' | ')} |`;
            changes.push(`고침 ${r.id}`);
          }
        } else {
          const cells = table.header.map(() => '');
          cells[0] = r.id;
          if (pageCol >= 0) cells[pageCol] = pageLink;
          if (srcCol >= 0 && r.sources !== null) cells[srcCol] = r.sources.trim();
          if (sumCol >= 0) cells[sumCol] = cut(r.text);
          const at = (anchor ?? lastRow) + 1;
          raw.splice(at, 0, `| ${cells.map(cellOut).join(' | ')} |`);
          for (const [id, i] of rowIndex) if (i >= at) rowIndex.set(id, i + 1);
          if (lastRow >= at - 1) lastRow++;
          rowIndex.set(r.id, at);
          anchor = at;
          changes.push(`넣음 ${r.id}`);
        }
      }
    }
    const rel = toPosix(path.relative(cfg.root, tp.file));
    for (const id of rowIndex.keys()) if (!defined.has(id)) out.push(`${rel}: ${id} 행의 규칙이 어느 페이지에도 없습니다(지우지 않음)`);
    if (changes.length) writePage(tp, raw, dry);
    const ins = changes.filter((c) => c.startsWith('넣음')).length;
    out.push(`${rel}: ${changes.length ? `넣음 ${ins}, 고침 ${changes.length - ins}` : '바꿀 것 없음'}${dry && changes.length ? ' (미리 보기)' : ''}`);
    if (opt.verbose) for (const c of changes) out.push(`  ${c}`);
  }
  if (!out.length) out.push(`추적표 페이지(${cfg.pages.traceability})가 없습니다`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// ---------------------------------------------------------------- sync impl

// 칸의 구현 상태. 비었으면 null, 정해진 말이 아니면 undefined. "다르게 구현됨: 무엇"처럼 뒤에 설명이 붙어도 된다.
function implStateOf(cell) {
  const s = plainText(cell).toLowerCase();
  if (!s) return null;
  for (const st of IMPL_STATES) {
    for (const label of [st.ko, st.en]) {
      const l = label.toLowerCase();
      if (s === l || (s.startsWith(l) && /^[\s(:：—–-]/.test(s.slice(l.length)))) return st.key;
    }
  }
  return undefined;
}

function implLabel(key, lang) {
  const st = IMPL_STATES.find((x) => x.key === key);
  return st[lang] || st.en;
}

// 상태 뒤에 붙은 설명: "다르게 구현됨(결제 시각 기준 168시간)" -> "결제 시각 기준 168시간"
function implNote(cell) {
  const s = plainText(cell);
  const low = s.toLowerCase();
  const st = IMPL_STATES.flatMap((x) => [x.ko, x.en]).find((l) => low.startsWith(l.toLowerCase()));
  if (!st) return '';
  return s.slice(st.length).trim().replace(/^[:：—–-]\s*/, '').replace(/^\((.*)\)$/, '$1').trim();
}

// 구현 상태 페이지의 절(제목 앞 번호는 뺀다)
const IMPL_SECTIONS = {
  baseline: /^(기준|Baseline)$/i,
  summary: /^(요약|Summary)$/i,
  different: /^(다르게 구현됨|Implemented differently)$/i,
  missing: /^(미구현|Not implemented)$/i,
  extra: /^(SRS에 없는 구현|Implemented but not in the SRS)$/i,
};

function sectionTable(page, re) {
  return page.tables.find((t) => re.test((t.sectionTitle || '').replace(/^[\d.\s]+/, '').trim()));
}

// 구현 대조 보고서(templates/briefs/impl-check.md): "규칙 ID"와 "상태" 열이 있는 표를 모두 읽는다
function readImplReport(file, cfg) {
  if (!exists(file)) die(`보고서가 없습니다: ${shown(file)}`);
  const { tables } = analyzeText(read(file));
  const rows = new Map();
  const skipped = [];
  for (const t of tables) {
    const idCol = columnIndex(t, /^(규칙 ID|Rule ID|ID)$/i);
    const stCol = columnIndex(t, /^(상태|구현 상태|Status|Implementation)$/i);
    if (idCol < 0 || stCol < 0) continue;
    const srsCol = columnIndex(t, /^(SRS 요약|SRS|SRS summary)$/i);
    const curCol = columnIndex(t, /^(현재 구현|차이|Current implementation|Difference)$/i);
    const resCol = columnIndex(t, /^(처리 제안|처리 방향|Resolution|Proposed resolution)$/i);
    for (const r of t.rows) {
      const ids = (r.cells[idCol] || '').split(/[,\s]+/).filter((x) => cfg.ruleIdRe.test(x));
      if (!ids.length) continue;
      const state = implStateOf(r.cells[stCol]);
      if (!state) {
        skipped.push(`${r.n}행 ${ids.join(', ')}: 상태가 정해진 말이 아니라 건너뜀("${(r.cells[stCol] || '').trim()}")`);
        continue;
      }
      const pick = (c) => (c >= 0 ? (r.raw[c] || '').trim() : '');
      for (const id of ids) rows.set(id, { state, srs: pick(srsCol), current: pick(curCol), resolution: pick(resCol) });
    }
  }
  if (!rows.size && !skipped.length) die(`${shown(file)}: "규칙 ID"와 "상태" 열이 있는 표가 없습니다(templates/briefs/impl-check.md의 보고서 형식)`);
  return { rows, skipped };
}

// 원래 줄 번호(0부터) 기준으로 지우고 넣는다. at에 넣는 줄은 그 줄 앞에 들어간다.
function applyLineEdits(raw, dels, inserts) {
  const out = [];
  for (let i = 0; i <= raw.length; i++) {
    if (inserts.has(i)) out.push(...inserts.get(i));
    if (i < raw.length && !dels.has(i)) out.push(raw[i]);
  }
  return out;
}

// 구현 대조 결과를 SRS에 옮긴다(PROCESS 3단계).
// 1) --from 보고서의 상태를 추적표 구현 상태 열에 쓴다. 번역 추적표는 고정 번역으로 같은 상태를 쓴다.
// 2) 구현 상태 페이지의 기준·요약 숫자를 추적표에서 다시 센다.
// 3) "다르게 구현됨"·"미구현" 표에 빠진 규칙 행을 넣는다. 있는 행의 글(처리 방향 등)은 고치지 않고,
//    상태가 바뀐 행은 알리기만 한다(--prune이면 지운다).
function runSyncImpl(cfg, opt) {
  const { pages, get } = loadPages(cfg);
  const dry = Boolean(opt['dry-run']);
  const relRoot = (abs) => toPosix(path.relative(cfg.root, abs));
  const lang0 = cfg.primaryLanguage;
  if (opt.date && !isDate(opt.date)) die(`--date는 YYYY-MM-DD: ${opt.date}`);
  const limit = Number(cfg.traceSummaryLength) || 80;
  const cut = (t) => {
    const s = plainText(t);
    return s.length > limit ? `${s.slice(0, limit).trimEnd()}…` : s;
  };
  const traceTable = (tp) => tp.tables.find((t) => /ID/i.test(t.header[0] || '') && columnIndex(t, IMPL_COL) >= 0);
  const tp0 = get(cfg.pages.traceability, lang0);
  if (!tp0) die(`추적표 페이지(${cfg.pages.traceability})가 없습니다`);
  if (!traceTable(tp0)) die(`${relRoot(tp0.file)}: 첫 열이 ID이고 "구현 상태" 열이 있는 표가 없습니다`);
  const report = opt.from ? readImplReport(path.resolve(opt.from), cfg) : null;
  const out = [];

  // 1. 추적표: 원문 먼저(상태를 모은다), 번역은 원문 상태로
  const states = new Map(); // 규칙 ID -> 상태 키
  const traceNotes = new Map(); // "언어:ID" -> 추적표 칸의 설명
  const order = []; // 추적표 순서
  const unknown = [];
  let emptyCount = 0;
  const notInTrace = new Set(report ? report.rows.keys() : []);
  for (const lang of cfg.langs) {
    const tp = get(cfg.pages.traceability, lang);
    if (!tp) continue;
    const table = traceTable(tp);
    if (!table) {
      out.push(`${relRoot(tp.file)}: "구현 상태" 열이 있는 표가 없습니다`);
      continue;
    }
    const col = columnIndex(table, IMPL_COL);
    const raw = [...tp.raw];
    let changed = 0;
    for (const r of table.rows) {
      const id = (r.cells[0] || '').trim();
      if (!cfg.ruleIdRe.test(id)) continue;
      const cells = splitCells(raw[r.n - 1]);
      while (cells.length < table.header.length) cells.push('');
      // 상태가 같으면 칸을 그대로 둔다("다르게 구현됨(무엇)"의 설명을 지우지 않는다)
      const has = implStateOf(cells[col]);
      let want;
      if (lang === lang0) {
        order.push(id);
        notInTrace.delete(id);
        const rep = report && report.rows.get(id);
        const key = rep ? rep.state : has;
        if (rep && rep.state !== has) want = implLabel(rep.state, lang);
        if (key === undefined) unknown.push(`${id} "${cells[col]}"`);
        else if (key) states.set(id, key);
        else emptyCount++;
      } else if (states.has(id) && states.get(id) !== has) want = implLabel(states.get(id), lang);
      if (want === undefined && has) traceNotes.set(`${lang}:${id}`, implNote(cells[col]));
      if (want !== undefined) {
        cells[col] = want;
        raw[r.n - 1] = `| ${cells.map(cellOut).join(' | ')} |`;
        changed++;
      }
    }
    if (changed) writePage(tp, raw, dry);
    out.push(`${relRoot(tp.file)}: ${changed ? `구현 상태 ${changed}칸 고침` : '바꿀 것 없음'}${dry && changed ? ' (미리 보기)' : ''}`);
  }

  // 2·3. 구현 상태 페이지
  for (const lang of cfg.langs) {
    const ip = get(cfg.pages.implementationStatus, lang);
    if (!ip) {
      out.push(`구현 상태 페이지(${cfg.pages.implementationStatus}${lang === lang0 ? '' : `, ${lang}`})가 없습니다`);
      continue;
    }
    const rules = new Map();
    for (const p of pages) if (p.lang === lang && !isInternal(p, cfg)) for (const r of extractRules(p, cfg)) if (!rules.has(r.id)) rules.set(r.id, r);
    const raw = [...ip.raw];
    const notes = [];
    let cellsChanged = 0;
    const setCell = (row, col, value) => {
      const cells = splitCells(raw[row.n - 1]);
      while (cells.length <= col) cells.push('');
      if (cells[col] === String(value)) return;
      cells[col] = String(value);
      raw[row.n - 1] = `| ${cells.map(cellOut).join(' | ')} |`;
      cellsChanged++;
    };
    const count = (key) => [...states.values()].filter((k) => k === key).length;

    const bt = sectionTable(ip, IMPL_SECTIONS.baseline);
    if (bt) {
      for (const r of bt.rows) {
        const label = (r.cells[0] || '').trim();
        if (/^(대조한 규칙 수|Rules checked)$/i.test(label)) setCell(r, 1, states.size);
        else if (/^(기준 커밋|Commit checked)$/i.test(label) && opt.commit) setCell(r, 1, opt.commit);
        else if (/^(대조한 날|Checked on)$/i.test(label) && (report || opt.date)) setCell(r, 1, opt.date || today());
      }
    }
    const st = sectionTable(ip, IMPL_SECTIONS.summary);
    if (st) {
      for (const r of st.rows) {
        const label = (r.cells[0] || '').trim();
        if (IMPL_SECTIONS.extra.test(label)) {
          const xt = sectionTable(ip, IMPL_SECTIONS.extra);
          if (xt) setCell(r, 1, xt.rows.filter((x) => (x.cells[0] || '').trim()).length);
        } else {
          const key = implStateOf(label);
          if (key) setCell(r, 1, count(key));
        }
      }
    }

    const dels = new Set();
    const inserts = new Map();
    let inserted = 0;
    let blank = 0;
    for (const key of ['different', 'missing']) {
      const t = sectionTable(ip, IMPL_SECTIONS[key]);
      if (!t) {
        if (count(key)) notes.push(`"${implLabel(key, lang)}" 절의 표가 없어 ${count(key)}행을 넣지 못함`);
        continue;
      }
      const have = new Map();
      for (const r of t.rows) {
        const id = (r.cells[0] || '').trim();
        if (cfg.ruleIdRe.test(id)) have.set(id, r);
      }
      const srsCol = columnIndex(t, /^(SRS|SRS 요약|SRS summary)$/i);
      const curCol = columnIndex(t, /^(현재 구현|Current implementation)$/i);
      const resCol = columnIndex(t, /^(처리 방향|처리 제안|Resolution)$/i);
      const lines = [];
      for (const id of order) {
        if (states.get(id) !== key || have.has(id)) continue;
        const rep = lang === lang0 && report ? report.rows.get(id) : null;
        const cells = t.header.map(() => '');
        cells[0] = id;
        if (srsCol >= 0) cells[srsCol] = rep && rep.srs ? rep.srs : rules.has(id) ? cut(rules.get(id).text) : '';
        // 보고서가 없으면 추적표 칸의 설명(그 칸을 고치지 않았을 때만 남아 있다)
        if (curCol >= 0) cells[curCol] = rep ? rep.current : traceNotes.get(`${lang}:${id}`) || '';
        if (resCol >= 0 && rep) cells[resCol] = rep.resolution;
        if (cells.slice(1).some((c) => !c)) blank++;
        lines.push(`| ${cells.map(cellOut).join(' | ')} |`);
      }
      if (lines.length) {
        inserts.set(t.rows.length ? t.rows[t.rows.length - 1].n : t.n + 1, lines);
        inserted += lines.length;
      }
      const stale = [...have.keys()].filter((id) => states.get(id) !== key);
      if (stale.length && opt.prune) for (const id of stale) dels.add(have.get(id).n - 1);
      else if (stale.length) notes.push(`"${implLabel(key, lang)}" 표에서 상태가 바뀐 행: ${stale.join(', ')} (지우지 않음, --prune이면 지운다)`);
    }
    if (blank) notes.push(`빈 칸이 있는 새 행 ${blank}개: 현재 구현·처리 방향·계획을 채운다${lang === lang0 ? '' : '(번역)'}`);

    const changes = cellsChanged + inserted + dels.size;
    if (changes) writePage(ip, applyLineEdits(raw, dels, inserts), dry);
    const parts = [`숫자 ${cellsChanged}칸`, `넣음 ${inserted}행`];
    if (dels.size) parts.push(`지움 ${dels.size}행`);
    out.push(`${relRoot(ip.file)}: ${changes ? parts.join(', ') : '바꿀 것 없음'}${dry && changes ? ' (미리 보기)' : ''}`);
    for (const n of notes) out.push(`  ${n}`);
  }

  const tally = ['done', 'different', 'missing', 'out'].map((k) => `${implLabel(k, 'ko')} ${[...states.values()].filter((v) => v === k).length}`).join(' · ');
  out.push(`상태: ${tally} · 비어 있음 ${emptyCount} (추적표 규칙 ${order.length}개)`);
  if (report) for (const s of report.skipped) out.push(`보고서 ${s}`);
  if (notInTrace.size) out.push(`보고서에만 있는 규칙 ID ${notInTrace.size}개(추적표에 없음, srs sync trace 먼저): ${[...notInTrace].slice(0, 10).join(', ')}${notInTrace.size > 10 ? ' …' : ''}`);
  if (unknown.length) out.push(`정해진 말이 아닌 구현 상태 ${unknown.length}개(세지 않음): ${unknown.slice(0, 10).join(', ')}${unknown.length > 10 ? ' …' : ''}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// 한국어 조사를 앞 글자의 받침에 맞춘다
function fixParticle(rest, word) {
  const last = word.trim().slice(-1);
  const code = last.charCodeAt(0);
  if (!(code >= 0xac00 && code <= 0xd7a3)) return null;
  const batchim = (code - 0xac00) % 28;
  const m = /^(으로|로|을|를|이|가|은|는|과|와)(?![가-힣])/.exec(rest);
  if (!m) return null;
  const pairs = { 을: ['을', '를'], 를: ['을', '를'], 이: ['이', '가'], 가: ['이', '가'], 은: ['은', '는'], 는: ['은', '는'], 과: ['과', '와'], 와: ['과', '와'] };
  let want;
  if (m[1] === '으로' || m[1] === '로') want = batchim === 0 || batchim === 8 ? '로' : '으로';
  else want = batchim ? pairs[m[1]][0] : pairs[m[1]][1];
  return want === m[1] ? null : { from: m[1], to: want };
}

// 링크 글자를 가리키는 페이지 제목으로 바꾼다(번호 없이 같은 이름이면 그대로 둔다)
function runSyncLinks(cfg, opt) {
  const { pages, get } = loadPages(cfg);
  const dry = Boolean(opt['dry-run']);
  const allowed = new Set(cfg.linkTextAllow || []);
  const stripNum = (s) => (s || '').replace(/^(\d+(?:\.\d+)*)\.?(?=\s|$)/, '').trim();
  const out = [];
  let total = 0;
  for (const p of pages) {
    const raw = [...p.raw];
    let n = 0;
    for (const l of p.lines) {
      if (l.inFence) continue;
      const i = l.n - 1;
      raw[i] = raw[i].replace(/(?<!!)\[([^\]\n]+)\]\(([^)\s]+)\)([가-힣]{0,2})/g, (all, txt, href, after) => {
        const target = resolveDocLink(p, href, cfg, get);
        if (!target || !target.fm.title) return all;
        const t = txt.trim();
        const title = target.fm.title;
        if (allowed.has(t) || cfg.ruleIdRe.test(t) || /^[\d.]+$/.test(t) || t === title || stripNum(t) === stripNum(title)) return all;
        n++;
        let rest = after;
        if (p.lang === 'ko') {
          const fix = fixParticle(after, title);
          if (fix) rest = fix.to + after.slice(fix.from.length);
        }
        return `[${title}](${href})${rest}`;
      });
    }
    if (n) {
      writePage(p, raw, dry);
      total += n;
      out.push(`  ${toPosix(path.relative(cfg.root, p.file))}: ${n}곳`);
    }
  }
  out.push(`링크 글자 ${total}곳을 페이지 제목으로 바꿈${dry && total ? ' (미리 보기)' : ''}. 화면 이름 같은 링크는 srs.config.json linkTextAllow에 넣으면 그대로 둔다`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// ---------------------------------------------------------------- 템플릿 복사

function fillPlaceholders(text, vars) {
  return text.replace(/\{\{([A-Z_]+)\}\}/g, (m, k) => (k in vars ? vars[k] : m));
}

function copyTree(src, dest, vars, log) {
  for (const f of walk(src)) {
    const out = path.join(dest, path.relative(src, f));
    const label = toPosix(path.relative(log.base, out));
    if (exists(out)) {
      if (!log.created.includes(label)) log.skipped.push(label);
      continue;
    }
    fs.mkdirSync(path.dirname(out), { recursive: true });
    if (/\.(mdx?|json|tsx?|md)$/.test(f)) fs.writeFileSync(out, fillPlaceholders(read(f), vars));
    else fs.copyFileSync(f, out);
    log.created.push(label);
  }
}

function addToMeta(dir, name) {
  const metaPath = path.join(dir, 'meta.json');
  if (!exists(metaPath)) return false;
  const meta = JSON.parse(read(metaPath));
  if (!Array.isArray(meta.pages)) return false;
  if (meta.pages.includes(name)) return true;
  meta.pages.push(name);
  fs.writeFileSync(metaPath, `${JSON.stringify(meta, null, 2)}\n`);
  return true;
}

function runInit(pos, opt) {
  const target = pos[0];
  if (!target) die('저장소 폴더를 주세요. 예: srs init ../my-project --name "프로젝트"');
  const root = path.resolve(target);
  if (!exists(root)) die(`폴더가 없습니다: ${root}`);
  const cfgFile = path.join(root, 'srs.config.json');
  const userCfg = exists(cfgFile) ? JSON.parse(read(cfgFile)) : {};
  const docsDir = opt.docs || userCfg.docsDir || DEFAULT_CONFIG.docsDir;
  const docsAbs = path.resolve(root, docsDir);
  const date = opt.date || today();
  if (!isDate(date)) die(`--date 형식이 YYYY-MM-DD가 아닙니다: ${date}`);
  const name = opt.name || path.basename(root);
  if (exists(docsAbs) && fs.readdirSync(docsAbs).length && !opt.force) {
    die(`${shown(docsAbs)}가 이미 있습니다. 없는 파일만 채우려면 --force (있는 파일은 덮어쓰지 않는다)`);
  }
  const vars = { PROJECT_NAME: name, DATE: date };
  const log = { created: [], skipped: [], base: root };
  if (opt.example) {
    // 예시 파일이 먼저 들어가고, 같은 이름의 빈 뼈대 파일은 건너뛴다.
    copyTree(path.join(TEMPLATE_DIR, 'examples'), docsAbs, vars, log);
  }
  copyTree(path.join(TEMPLATE_DIR, 'docs', 'srs'), docsAbs, vars, log);
  if (opt.example) addToMeta(path.join(docsAbs, 'features'), 'order-cancellation');
  if (!exists(cfgFile)) {
    const cfg = JSON.parse(read(path.join(TEMPLATE_DIR, 'srs.config.json')));
    cfg.docsDir = docsDir;
    fs.writeFileSync(cfgFile, `${JSON.stringify(cfg, null, 2)}\n`);
    log.created.push('srs.config.json');
  } else log.skipped.push('srs.config.json');
  if (opt.web) {
    if (!exists(WEB_TEMPLATE_DIR)) die(`문서 사이트 코드가 이 키트에 없습니다(${shown(WEB_TEMPLATE_DIR)}). --web 없이 실행한다`);
    const webAbs = path.resolve(root, opt.web);
    if (!exists(webAbs)) die(`앱 폴더가 없습니다: ${webAbs}`);
    const webVars = {
      ...vars,
      DOCS_DIR_FROM_APP: toPosix(path.relative(webAbs, docsAbs)),
      VERSIONS_DIR_FROM_APP: toPosix(path.relative(webAbs, path.resolve(root, userCfg.versionsDir || DEFAULT_CONFIG.versionsDir))),
    };
    copyTree(WEB_TEMPLATE_DIR, webAbs, webVars, log);
  }
  if (opt.quiet) return log;
  const out = [`대상: ${shown(root) || '.'}`, `만든 파일 ${log.created.length}개`];
  for (const f of log.created) out.push(`  + ${f}`);
  if (log.skipped.length) {
    out.push(`이미 있어 건너뛴 파일 ${log.skipped.length}개 (덮어쓰지 않음)`);
    for (const f of log.skipped) out.push(`  = ${f}`);
  }
  out.push('');
  out.push('다음 단계 (PROCESS.md 0단계):');
  const siteStep = opt.web ? 'web/README.md의 "합칠 것"을 확인'
    : exists(WEB_TEMPLATE_DIR) ? 'srs init <저장소> --web <앱 폴더> --force 또는 web/README.md'
    : `${shown(path.join(KIT_DIR, 'SITE.md'))}대로 사이트 세션(templates/briefs/site.md)에 맡긴다`;
  out.push(`  1. 사이트 연결: ${siteStep}`);
  out.push('  2. overview의 "합의 방식"을 고객사와 정한다');
  out.push('  3. 출처 전수 확인(baseline/sources) → srs new feature <slug> --title "..." --code ABC');
  out.push(`  4. 검사: srs check --root ${shown(root) || '.'}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

function runNew(cfg, pos, opt) {
  const kind = pos[0];
  const slug = pos[1];
  const KINDS = { feature: 'features', policy: 'policies' };
  if (!KINDS[kind]) die('종류는 feature 또는 policy다. 예: srs new feature order-cancellation --title "주문 취소" --code CAN');
  if (!slug || !/^[a-z0-9][a-z0-9-]*$/.test(slug)) die('slug는 영문 소문자·숫자·하이픈이다');
  if (!opt.title) die('--title이 필요하다');
  const code = opt.code;
  if (!code || !/^[A-Z][A-Z0-9]{1,4}$/.test(code)) die('--code는 영문 대문자 2~5자다(규칙 ID 접두어)');
  const dirName = Object.entries(cfg.formDirs).find(([, k]) => k === kind)?.[0] || KINDS[kind];
  const dir = path.join(cfg.docsAbs, dirName);
  const { pages } = exists(cfg.docsAbs) ? loadPages(cfg) : { pages: [] };
  const used = pages.find((p) => p.fm.code === code);
  if (used) die(`code ${code}는 ${toPosix(path.relative(cfg.root, used.file))}에서 쓰고 있다`);
  const date = opt.date || today();
  const files = [
    [path.join(TEMPLATE_DIR, 'pages', `${kind}.mdx`), path.join(dir, `${slug}.mdx`), opt.title, opt.description || ''],
    ...cfg.translations.map((t) => [path.join(TEMPLATE_DIR, 'pages', `${kind}.en.mdx`), path.join(dir, `${slug}.${t}.mdx`), opt['en-title'] || opt.title, opt['en-description'] || '']),
  ];
  for (const [, dest] of files) if (exists(dest)) die(`이미 있다: ${shown(dest)}`);
  fs.mkdirSync(dir, { recursive: true });
  const out = [];
  for (const [src, dest, title, description] of files) {
    fs.writeFileSync(dest, fillPlaceholders(read(src), { TITLE: title.replace(/"/g, '\\"'), DESCRIPTION: description.replace(/"/g, '\\"'), DATE: date, CODE: code }));
    out.push(`  + ${toPosix(path.relative(cfg.root, dest))}`);
  }
  if (addToMeta(dir, slug)) out.push(`  meta.json에 "${slug}" 추가`);
  else out.push(`  ${dirName}/meta.json에 pages가 없어 순서에 넣지 않았다`);
  if (!opt['en-title'] && cfg.translations.length) out.push('  번역 파일 title이 원문과 같다. 번역할 때 고친다(--en-title로 처음부터 줄 수 있다)');
  out.push(`  규칙 ID는 ${code}-01부터. 다음: 추적표(baseline/traceability)에 규칙 ID를 넣는다`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// ---------------------------------------------------------------- 출처 등록(source)과 온보딩(onboard)

const UNREAD = { ko: '읽기 전', en: 'Not read yet' };
const UNREAD_RE = /^(읽기 전|Not read yet)$/i;

// 출처 종류와 순위(STANDARD 3절)
const SOURCE_KINDS = [
  { key: 'contract', rank: 1, ko: '계약 자료', en: 'Contract', hint: '계약서, 추가 계약, 계약에 붙은 제안서·견적·범위표' },
  { key: 'client', rank: 3, ko: '고객사 답·요청', en: 'Client answer or request', hint: '요청 게시판, 메일, 메신저, 회의록, 고객사가 쓴 기획 문서' },
  { key: 'design', rank: 4, ko: '화면', en: 'Screens', hint: '디자인, 목업, 와이어프레임, 화면 캡처' },
  { key: 'decision', rank: 5, ko: '팀 결정', en: 'Team decision', hint: '이슈의 결정 코멘트, 기술 스펙, 내부 회의록' },
  { key: 'code', rank: 6, ko: '현재 구현', en: 'Current build', hint: '코드 저장소, 운영·테스트 화면(사실 확인용)' },
  { key: 'old', rank: 7, ko: '과거 자료', en: 'Past material', hint: '초기 기획서, 지난 견적, 이후 답으로 바뀐 것' },
];

const FILE_TYPES = [
  [/\.pdf$/i, 'PDF', 'PDF'],
  [/\.(docx?|rtf|odt)$/i, 'Word', 'Word'],
  [/\.(hwpx?)$/i, '한글 문서', 'HWP'],
  [/\.(xlsx?|csv|tsv|numbers)$/i, '표', 'Spreadsheet'],
  [/\.(pptx?|key)$/i, '발표 자료', 'Slides'],
  [/\.(png|jpe?g|gif|webp|heic)$/i, '이미지', 'Image'],
  [/\.(mdx?|txt)$/i, '텍스트', 'Text'],
  [/\.(eml|msg)$/i, '메일', 'Email'],
];

function expandHome(p) {
  return p.replace(/^~(?=$|\/)/, process.env.HOME || '~');
}

// 붙여 넣은 위치가 무엇인지 알아낸다
function detectSource(input, root) {
  const loc = input.trim().replace(/^<(.+)>$/, '$1').replace(/^["'](.+)["']$/, '$1');
  if (/^https?:\/\//i.test(loc)) {
    let host = '';
    let u = null;
    try {
      u = new URL(loc);
      host = u.hostname.toLowerCase();
    } catch {
      /* 그대로 웹 페이지로 본다 */
    }
    const pathname = u ? decodeURIComponent(u.pathname) : '';
    const base = { kind: 'url', url: loc };
    if (/(^|\.)notion\.(so|site)$|(^|\.)notion\.com$/.test(host)) {
      const last = pathname.split('/').filter(Boolean).pop() || '';
      const title = last.replace(/-?[0-9a-f]{32}$/i, '').replace(/-/g, ' ').trim();
      return { ...base, type: 'notion', ko: 'Notion', en: 'Notion', title, guess: 'client', tree: true };
    }
    if (/docs\.google\.com|drive\.google\.com/.test(host)) {
      const t = /\/(document|spreadsheets|presentation|forms)\//.exec(pathname);
      const kinds = { document: ['Google 문서', 'Google Docs'], spreadsheets: ['Google 시트', 'Google Sheets'], presentation: ['Google 슬라이드', 'Google Slides'], forms: ['Google 설문', 'Google Forms'] };
      const [ko, en] = t ? kinds[t[1]] : ['Google 드라이브', 'Google Drive'];
      return { ...base, type: 'google', ko, en, title: '', guess: 'client', tree: !t };
    }
    if (/figma\.com$/.test(host)) {
      const parts = pathname.split('/').filter(Boolean);
      return { ...base, type: 'figma', ko: 'Figma', en: 'Figma', title: (parts[2] || '').replace(/-/g, ' '), guess: 'design' };
    }
    if (/github\.com$/.test(host)) {
      const m = /^\/([^/]+)\/([^/]+)\/(issues|pull|discussions)\/(\d+)/.exec(pathname);
      if (m) return { ...base, type: 'github', ko: m[3] === 'pull' ? 'GitHub PR' : 'GitHub 이슈', en: m[3] === 'pull' ? 'GitHub PR' : 'GitHub issue', title: `${m[2]}#${m[4]}`, guess: 'decision' };
      return { ...base, type: 'github', ko: 'GitHub', en: 'GitHub', title: pathname.split('/').filter(Boolean).slice(0, 2).join('/'), guess: 'code' };
    }
    if (/atlassian\.net$|jira/.test(host)) return { ...base, type: 'jira', ko: '이슈 트래커', en: 'Issue tracker', title: '', guess: 'decision' };
    if (/slack\.com$/.test(host)) return { ...base, type: 'slack', ko: '메신저', en: 'Chat', title: '', guess: 'client' };
    const fileType = FILE_TYPES.find(([re]) => re.test(pathname));
    const last = pathname.split('/').filter(Boolean).pop() || host;
    if (fileType) return { ...base, type: 'file-url', ko: fileType[1], en: fileType[2], title: last.replace(/\.[^.]+$/, ''), guess: guessKind(last) };
    return { ...base, type: 'web', ko: '웹 페이지', en: 'Web page', title: last, guess: 'client' };
  }
  const abs = path.resolve(root, expandHome(loc));
  if (exists(abs)) {
    const name = path.basename(abs);
    if (fs.statSync(abs).isDirectory()) return { kind: 'dir', file: abs, type: 'dir', ko: '폴더', en: 'Folder', title: name, guess: guessKind(name), tree: true };
    const fileType = FILE_TYPES.find(([re]) => re.test(name));
    return { kind: 'file', file: abs, type: 'file', ko: fileType ? fileType[1] : '파일', en: fileType ? fileType[2] : 'File', title: name.replace(/\.[^.]+$/, ''), guess: guessKind(name) };
  }
  if (/^(\/|~\/|\.\.?\/)/.test(loc) || /\.[a-z0-9]{2,5}$/i.test(loc) && !/\s/.test(loc)) return { kind: 'missing', file: abs };
  // 링크도 파일도 아니면 메모(예: "고객사 메신저 대화 9/1~9/30, PM이 보관")
  return { kind: 'note', type: 'note', ko: '메모', en: 'Note', title: loc.length > 60 ? `${loc.slice(0, 60)}…` : loc, note: loc, guess: 'client' };
}

function guessKind(name) {
  if (/계약|contract|agreement|견적|quot|제안|proposal|범위|scope|sow/i.test(name)) return 'contract';
  if (/디자인|design|목업|mockup|wire|와이어|화면|screen|figma|\.(png|jpe?g|gif|webp|heic)$/i.test(name)) return 'design';
  if (/회의|meeting|minutes|요청|request|답변|qna|q&a/i.test(name)) return 'client';
  if (/초기|old|구버전|legacy|이전/i.test(name)) return 'old';
  return 'client';
}

function kindOf(keyOrRank) {
  if (keyOrRank === undefined || keyOrRank === null || keyOrRank === '') return null;
  return SOURCE_KINDS.find((k) => k.key === keyOrRank || String(k.rank) === String(keyOrRank)) || null;
}

function sourcesTables(page) {
  const list = page.tables.find((t) => columnIndex(t, /(반영|Reflected|Used in)/i) >= 0 && columnIndex(t, /^(ID|출처 ID|Source ID)$/i) >= 0);
  const cover = page.tables.find((t) => /^(출처 묶음|Source group)$/i.test((t.header[0] || '').trim()));
  return { list, cover };
}

function nextSourceId(page) {
  const { list } = sourcesTables(page);
  let max = 0;
  for (const r of list ? list.rows : []) {
    const m = /^SRC-(\d+)$/.exec((r.cells[0] || '').trim());
    if (m) max = Math.max(max, Number(m[1]));
  }
  return `SRC-${String(max + 1).padStart(3, '0')}`;
}

function insertRow(raw, table, cells) {
  const at = table.rows.length ? table.rows[table.rows.length - 1].n : table.n + 1; // raw 줄 번호(0부터)로 마지막 행 다음
  raw.splice(at, 0, `| ${cells.map(cellOut).join(' | ')} |`);
}

// 출처 한 개를 원문·번역 출처 목록에 넣고 보관함 기록(manifest)에 지문을 남긴다. 쓴 ID를 돌려준다
// meta: { title, kind, date, group, copy, edited, files }
function registerSource(cfg, get, src, meta, opt) {
  const primaryPage = get(cfg.pages.sources);
  if (!primaryPage) die(`출처 목록 페이지(${cfg.pages.sources})가 없습니다. 먼저 srs init`);
  const id = opt.id || nextSourceId(primaryPage);
  const date = today();
  const where = src.file ? displayPath(cfg, src.file) : null;
  for (const lang of cfg.langs) {
    const page = get(cfg.pages.sources, lang);
    if (!page) continue;
    const { list, cover } = sourcesTables(page);
    if (!list) die(`${shown(page.file)}에 "ID … 반영 위치" 열이 있는 출처 표가 없습니다`);
    const en = lang !== 'ko';
    const typeLabel = en ? src.en : src.ko;
    const title = meta.title || (en ? 'Untitled' : '제목 없음');
    let cell;
    if (src.url) cell = `[${title.replace(/[[\]]/g, '')}](${src.url}) · ${typeLabel}`;
    else if (src.file) cell = `${title} · ${typeLabel} · \`${where}\``;
    else cell = `${title} · ${typeLabel}`;
    if (meta.group) cell += en ? ' · group' : ' · 묶음';
    const cells = list.header.map(() => '');
    const set = (re, v) => {
      const i = columnIndex(list, re);
      if (i >= 0) cells[i] = v;
    };
    cells[0] = id;
    set(/^(출처|Source)$/i, cell);
    set(/^(순위|Rank)$/i, String(meta.kind.rank));
    set(/^(문서 날짜|Document date)$/i, meta.date || '');
    set(/^(확인일|Checked on)$/i, date);
    set(/(반영|Reflected|Used in)/i, en ? UNREAD.en : UNREAD.ko);
    const raw = [...page.raw];
    // 아래쪽 표부터 넣어야 위쪽 표의 줄 번호가 그대로다
    const jobs = [[list, cells]];
    if (meta.group && cover) {
      const c = cover.header.map(() => '');
      c[0] = title;
      if (c.length > 1) c[1] = src.url ? `[${en ? 'link' : '링크'}](${src.url})` : `\`${where || ''}\``;
      if (meta.files && c.length > 3) c[2] = c[3] = String(meta.files.length);
      if (c.length > 4) c[4] = date;
      jobs.push([cover, c]);
    }
    jobs.sort((a, b) => b[0].n - a[0].n);
    for (const [t, c] of jobs) insertRow(raw, t, c);
    if (!opt['dry-run']) fs.writeFileSync(page.file, raw.join(page.text.includes('\r\n') ? '\r\n' : '\n'));
  }
  if (!opt['dry-run']) {
    const m = loadManifest(cfg);
    const entry = { type: src.kind === 'dir' ? 'dir' : src.kind, checked: date };
    if (src.url) {
      entry.url = src.url;
      if (meta.edited) entry.edited = meta.edited;
    }
    if (src.kind === 'file') {
      Object.assign(entry, { path: where }, fingerprint(src.file));
      if (meta.copy) entry.copies = [snapshotSource(cfg, id, src.file)];
    }
    if (src.kind === 'dir') Object.assign(entry, { path: where, files: meta.files || folderFiles(src.file).map((f) => toPosix(path.relative(src.file, f))) });
    m.sources[id] = entry;
    saveManifest(cfg, m);
  }
  return id;
}

// ---- 근거 파일 보관함(sourcesDir): 사본과 지문 기록. 사본은 git에 올라가지 않는다

const crypto = require('node:crypto');

function vaultDir(cfg) {
  return path.resolve(cfg.root, cfg.sourcesDir || 'srs-sources');
}

function ensureVault(cfg) {
  const dir = vaultDir(cfg);
  fs.mkdirSync(dir, { recursive: true });
  const gi = path.join(dir, '.gitignore');
  const want = '# srs-kit 근거 파일 보관함. 사본은 계약서 같은 비공개 문서일 수 있어 git에 올리지 않는다.\n# 지문 기록(manifest.json)만 올려 팀이 원본이 바뀌었는지 함께 본다.\n*\n!.gitignore\n!manifest.json\n';
  if (!exists(gi) || read(gi) !== want) fs.writeFileSync(gi, want);
  return dir;
}

function loadManifest(cfg) {
  const f = path.join(vaultDir(cfg), 'manifest.json');
  if (!exists(f)) return { version: 1, sources: {} };
  try {
    const m = JSON.parse(read(f));
    m.sources = m.sources || {};
    return m;
  } catch (e) {
    die(`${shown(f)}: JSON을 읽을 수 없습니다 (${e.message})`);
  }
}

function saveManifest(cfg, m) {
  const dir = ensureVault(cfg);
  const sorted = {};
  for (const k of Object.keys(m.sources).sort()) sorted[k] = m.sources[k];
  fs.writeFileSync(path.join(dir, 'manifest.json'), `${JSON.stringify({ version: 1, sources: sorted }, null, 2)}\n`);
}

function fingerprint(file) {
  const buf = fs.readFileSync(file);
  return { sha256: crypto.createHash('sha256').update(buf).digest('hex'), size: buf.length };
}

// 사본은 <보관함>/<ID>/<날짜>-<파일 이름>. 같은 내용이 이미 있으면 새로 만들지 않는다
function snapshotSource(cfg, id, file) {
  const dir = path.join(ensureVault(cfg), id);
  fs.mkdirSync(dir, { recursive: true });
  const fp = fingerprint(file).sha256;
  for (const f of fs.readdirSync(dir)) {
    const p = path.join(dir, f);
    if (fs.statSync(p).isFile() && fingerprint(p).sha256 === fp) return toPosix(path.relative(cfg.root, p));
  }
  let dest = path.join(dir, `${today()}-${path.basename(file)}`);
  for (let i = 2; exists(dest); i++) dest = path.join(dir, `${today()}-${i}-${path.basename(file)}`);
  fs.copyFileSync(file, dest);
  return toPosix(path.relative(cfg.root, dest));
}

// 출처 목록에 적는 원본 위치: 저장소 안이면 저장소 기준, 집 폴더 아래면 ~/…
function displayPath(cfg, file) {
  const rel = path.relative(cfg.root, file);
  if (!rel.startsWith('..') && !path.isAbsolute(rel)) return toPosix(rel);
  const home = process.env.HOME;
  return home && file.startsWith(`${home}/`) ? `~/${toPosix(path.relative(home, file))}` : toPosix(file);
}

function resolveWhere(cfg, where) {
  return path.resolve(cfg.root, expandHome(where));
}

// 저장소 안의 원본 파일이 git에 올라갈 수 있는지(무시되지 않으면 경고 문장)
function repoExposure(cfg, file) {
  const rel = path.relative(cfg.root, file);
  if (rel.startsWith('..') || path.isAbsolute(rel)) return null;
  if (git(cfg, ['rev-parse', '--is-inside-work-tree'], { allowFail: true }) === null) return null;
  if (git(cfg, ['check-ignore', '-q', '--', rel], { allowFail: true }) !== null) return null;
  const tracked = git(cfg, ['ls-files', '--error-unmatch', '--', rel], { allowFail: true }) !== null;
  return `${toPosix(rel)}는 저장소 안에 있고 git이 무시하지 않는다${tracked ? '(이미 커밋됨)' : ''}. 공유하면 안 되는 문서면 저장소 밖으로 옮기거나 .gitignore에 넣는다`;
}

function folderFiles(dir) {
  return walk(dir).filter((f) => FILE_TYPES.some(([re]) => re.test(f))).slice(0, 500);
}

// 기록한 지문과 지금 원본을 비교한다
function sourceStatuses(cfg) {
  const m = loadManifest(cfg);
  const out = [];
  for (const [id, e] of Object.entries(m.sources)) {
    const s = { id, entry: e, state: 'same', detail: '' };
    if (e.type === 'file') {
      const f = resolveWhere(cfg, e.path);
      if (!exists(f)) Object.assign(s, { state: 'missing', detail: `이 기기에 원본이 없다: ${e.path}` });
      else if (fingerprint(f).sha256 !== e.sha256) Object.assign(s, { state: 'changed', detail: `${e.checked} 확인 뒤 원본이 바뀌었다: ${e.path}` });
    } else if (e.type === 'dir') {
      const d = resolveWhere(cfg, e.path);
      if (!exists(d)) Object.assign(s, { state: 'missing', detail: `이 기기에 폴더가 없다: ${e.path}` });
      else {
        const now = folderFiles(d).map((f) => toPosix(path.relative(d, f)));
        const added = now.filter((f) => !(e.files || []).includes(f));
        const removed = (e.files || []).filter((f) => !now.includes(f));
        if (added.length || removed.length) Object.assign(s, { state: 'changed', detail: `폴더 문서가 바뀌었다: 새 문서 ${added.length}개${added.length ? `(${added.slice(0, 3).join(', ')}${added.length > 3 ? ' …' : ''})` : ''}, 없어진 문서 ${removed.length}개`, added, removed });
      }
    } else if (e.type === 'url') Object.assign(s, { state: 'url', detail: `${e.checked} 확인${e.edited ? `, 그때 문서 수정일 ${e.edited}` : ''}. 링크 문서는 열어서 수정일을 비교한다` });
    else s.state = 'note';
    out.push(s);
  }
  return out;
}

// 출처 목록의 확인일 칸을 고친다(원문·번역)
function setCheckedDate(cfg, id, date, opt) {
  const { get } = loadPages(cfg);
  for (const lang of cfg.langs) {
    const page = get(cfg.pages.sources, lang);
    if (!page) continue;
    const { list } = sourcesTables(page);
    const col = list ? columnIndex(list, /^(확인일|Checked on)$/i) : -1;
    const row = list && list.rows.find((r) => (r.cells[0] || '').trim() === id);
    if (!row || col < 0) continue;
    const raw = [...page.raw];
    const cells = splitCells(raw[row.n - 1]);
    cells[col] = date;
    raw[row.n - 1] = `| ${cells.map(cellOut).join(' | ')} |`;
    if (!opt['dry-run']) fs.writeFileSync(page.file, raw.join('\n'));
  }
}

function runSourceAdd(cfg, pos, opt) {
  const input = pos.join(' ');
  if (!input) die('위치를 주세요. 예: srs source add https://www.notion.so/… --kind client');
  const { get } = loadPages(cfg);
  const src = detectSource(input, process.cwd());
  if (src.kind === 'missing') die(`파일이 없습니다: ${src.file}`);
  const kind = kindOf(opt.kind ?? opt.rank) || kindOf(src.guess);
  if ((opt.kind || opt.rank) && !kindOf(opt.kind ?? opt.rank)) die(`--kind는 ${SOURCE_KINDS.map((k) => k.key).join(', ')} 중 하나, 또는 --rank 1·3~7`);
  for (const k of ['date', 'edited']) if (opt[k] && !isDate(opt[k])) die(`--${k} 형식이 YYYY-MM-DD가 아닙니다: ${opt[k]}`);
  const out = [];
  const warnExposure = (f) => {
    const w = repoExposure(cfg, f);
    if (w) out.push(`  주의: ${w}`);
  };
  if (src.kind === 'dir' && opt.each) {
    const files = folderFiles(src.file);
    for (const f of files) {
      const fsrc = detectSource(f, process.cwd());
      const id = registerSource(cfg, loadPages(cfg).get, fsrc, { title: fsrc.title, kind: kindOf(opt.kind ?? opt.rank) || kindOf(fsrc.guess), date: opt.date, copy: opt.copy }, opt);
      out.push(`  ${id}  ${fsrc.ko}  ${fsrc.title}`);
      warnExposure(f);
    }
    const key = recordFolder(cfg, src, opt.title || src.title, files, opt);
    out.push(`폴더의 문서 ${files.length}개를 넣었다. 폴더는 확인 범위 표와 보관함 기록(${key})에 남겨 새 문서가 생기면 srs check가 알린다`);
  } else {
    const meta = { title: opt.title || src.title, kind, date: opt.date, edited: opt.edited, group: Boolean(opt.group || src.kind === 'dir'), copy: opt.copy && src.kind === 'file' };
    const id = registerSource(cfg, get, src, meta, opt);
    out.push(`${id}  ${src.ko} · ${kind.ko}(순위 ${kind.rank})  ${meta.title || '(제목 없음)'}${meta.group ? '  [묶음: 하위 문서를 모두 열어 한 행씩 넣는다]' : ''}${meta.copy ? `  [사본: ${cfg.sourcesDir || 'srs-sources'}/${id}/, git에 올라가지 않음]` : ''}`);
    if (src.file) warnExposure(src.file);
  }
  if (opt['dry-run']) out.push('(미리 보기, 쓰지 않음)');
  process.stdout.write(`${out.join('\n')}\n`);
}

// 폴더 묶음: 확인 범위 표에 한 행(전체 수 = 넣은 수), 보관함 기록에 문서 목록. 기록 키를 돌려준다
function recordFolder(cfg, src, title, files, opt) {
  const where = displayPath(cfg, src.file);
  const key = `folder:${where}`;
  if (opt['dry-run']) return key;
  const { get } = loadPages(cfg);
  for (const lang of cfg.langs) {
    const page = get(cfg.pages.sources, lang);
    if (!page) continue;
    const { cover } = sourcesTables(page);
    if (!cover) continue;
    const c = cover.header.map(() => '');
    c[0] = title;
    if (c.length > 1) c[1] = `\`${where}\``;
    if (c.length > 3) c[2] = c[3] = String(files.length);
    if (c.length > 4) c[4] = today();
    const raw = [...page.raw];
    insertRow(raw, cover, c);
    fs.writeFileSync(page.file, raw.join('\n'));
  }
  const m = loadManifest(cfg);
  m.sources[key] = { type: 'dir', path: where, files: files.map((f) => toPosix(path.relative(src.file, f))), checked: today() };
  saveManifest(cfg, m);
  return key;
}

function runSourceList(cfg, opt) {
  const { get } = loadPages(cfg);
  const page = get(cfg.pages.sources);
  if (!page) die(`출처 목록 페이지(${cfg.pages.sources})가 없습니다`);
  const { list, cover } = sourcesTables(page);
  const rCol = columnIndex(list, /(반영|Reflected|Used in)/i);
  const sCol = columnIndex(list, /^(출처|Source)$/i);
  const rkCol = columnIndex(list, /^(순위|Rank)$/i);
  const rows = list.rows.filter((r) => !opt.unread || UNREAD_RE.test((r.cells[rCol] || '').trim()));
  const out = [];
  for (const r of rows) {
    const raw = r.raw[sCol] || '';
    const link = /\]\(([^)]+)\)/.exec(raw);
    const file = /`([^`]+)`/.exec(raw);
    out.push(`${r.cells[0]}\t순위 ${r.cells[rkCol] || '-'}\t${(r.cells[rCol] || '').trim()}\t${plainText(r.cells[sCol])}${link ? `\t${link[1]}` : file ? `\t${file[1]}` : ''}`);
  }
  const unread = list.rows.filter((r) => UNREAD_RE.test((r.cells[rCol] || '').trim())).length;
  out.push(`출처 ${list.rows.length}개, 읽기 전 ${unread}개${cover && cover.rows.length ? `, 묶음 ${cover.rows.length}개` : ''}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

const STATE_LABEL = { same: '그대로', changed: '바뀜', missing: '이 기기에 없음', url: '링크', note: '메모' };

function runSourceStatus(cfg, opt) {
  const list = sourceStatuses(cfg).filter((s) => !opt.changed || s.state === 'changed');
  const out = list.map((s) => `${s.id}\t${STATE_LABEL[s.state]}\t${s.entry.checked || '-'}\t${s.detail || s.entry.path || s.entry.url || ''}`);
  const changed = list.filter((s) => s.state === 'changed').length;
  out.push(`기록 ${list.length}개, 바뀜 ${changed}개${changed ? '. 다시 읽고 SRS에 반영한 뒤 srs source refresh <ID>' : ''}`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// 다시 읽고 반영한 출처의 지문·확인일을 지금 원본으로 고친다. 사본을 두던 출처는 새 사본을 날짜별로 남긴다
function runSourceRefresh(cfg, pos, opt) {
  const statuses = sourceStatuses(cfg);
  const ids = opt.all ? statuses.filter((s) => s.state === 'changed').map((s) => s.id) : pos;
  if (!ids.length) die(opt.all ? '바뀐 출처가 없습니다' : '출처 ID를 주세요. 예: srs source refresh SRC-002 (바뀐 것 모두: --all)');
  if (opt.edited && !isDate(opt.edited)) die(`--edited 형식이 YYYY-MM-DD가 아닙니다: ${opt.edited}`);
  const m = loadManifest(cfg);
  const date = today();
  const out = [];
  for (const id of ids) {
    const e = m.sources[id];
    if (!e) die(`${id}: 보관함 기록이 없습니다(srs source add로 넣은 출처만 갱신한다). 기록 키는 srs source status`);
    if (e.type === 'file') {
      const f = resolveWhere(cfg, e.path);
      if (!exists(f)) die(`${id}: 이 기기에 원본이 없습니다: ${e.path}`);
      const before = e.sha256;
      Object.assign(e, fingerprint(f));
      if (opt.copy || (e.copies && e.copies.length)) {
        const c = snapshotSource(cfg, id, f);
        e.copies = [...new Set([...(e.copies || []), c])];
      }
      out.push(`${id}: ${before === e.sha256 ? '내용 그대로' : '새 지문 기록'}${e.copies ? `, 사본 ${e.copies.length}개(${e.copies[e.copies.length - 1]})` : ''}`);
    } else if (e.type === 'dir') {
      const d = resolveWhere(cfg, e.path);
      if (!exists(d)) die(`${id}: 이 기기에 폴더가 없습니다: ${e.path}`);
      if (opt.each) for (const f of folderFiles(d).filter((x) => !(e.files || []).includes(toPosix(path.relative(d, x))))) out.push(`  ${registerSource(cfg, loadPages(cfg).get, detectSource(f, process.cwd()), { title: path.basename(f).replace(/\.[^.]+$/, ''), kind: kindOf(guessKind(f)), copy: opt.copy }, opt)} 넣음: ${path.basename(f)}`);
      const now = folderFiles(d).map((f) => toPosix(path.relative(d, f)));
      const added = now.filter((f) => !(e.files || []).includes(f));
      e.files = now;
      out.push(`${id}: 폴더 문서 목록 갱신(새 문서 ${added.length}개)`);
      if (!opt.each) for (const f of added) out.push(`  새 문서는 출처로 넣는다: srs source add "${path.join(e.path, f)}" (또는 refresh --each)`);
    } else if (e.type === 'url' && opt.edited) e.edited = opt.edited;
    e.checked = date;
    if (!id.startsWith('folder:')) setCheckedDate(cfg, id, date, opt);
  }
  if (!opt['dry-run']) saveManifest(cfg, m);
  out.push(`확인일을 ${date}로 고쳤다(출처 목록, 보관함 기록)`);
  process.stdout.write(`${out.join('\n')}\n`);
}

// ---------------------------------------------------------------- onboard

async function runOnboard(pos, opt) {
  const readline = require('node:readline');
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: process.stdin.isTTY });
  const lines = [];
  const waiters = [];
  let closed = false;
  rl.on('line', (l) => (waiters.length ? waiters.shift()(l) : lines.push(l)));
  rl.on('close', () => {
    closed = true;
    while (waiters.length) waiters.shift()(null);
  });
  const say = (s = '') => process.stdout.write(`${s}\n`);
  const ask = (q, def) => {
    process.stdout.write(`${q}${def ? ` [${def}]` : ''} › `);
    return new Promise((resolve) => {
      const done = (l) => {
        if (!process.stdin.isTTY) process.stdout.write(`${l ?? ''}\n`);
        resolve(l === null ? null : l.trim() || def || '');
      };
      if (lines.length) done(lines.shift());
      else if (closed) done(null);
      else waiters.push(done);
    });
  };
  const yes = async (q, def = true) => {
    const a = await ask(`${q} (${def ? 'Y/n' : 'y/N'})`);
    if (a === null || a === '') return def;
    return /^(y|yes|네|예|응|ㅇ)/i.test(a);
  };

  const root = path.resolve(pos[0] || opt.root || findRoot(process.cwd()));
  say('');
  say('SRS 온보딩');
  say('──────────');
  say('고객사와 합의할 SRS를 이 저장소에 세팅하고, 근거 문서를 출처 목록에 모은다.');
  say(`저장소: ${root}`);
  say('');

  // 1. 세팅
  let cfg = loadConfig({ ...opt, root });
  if (!exists(path.join(cfg.docsAbs, `${cfg.pages.sources}.mdx`))) {
    say('1/3  기본 정보');
    const name = await ask('프로젝트 이름', path.basename(root));
    if (name === null) return rl.close();
    const example = await yes('예시 기능 페이지(주문 취소와 환불)를 함께 넣을까요?', false);
    const log = runInit([root], { ...opt, name, example, quiet: true, force: exists(cfg.docsAbs) });
    say(`  docs/srs 뼈대와 srs.config.json을 만들었다(파일 ${log.created.length}개).`);
    cfg = loadConfig({ ...opt, root });
  } else {
    say('1/3  기본 정보: 이미 세팅돼 있다. 근거 문서만 더 넣는다.');
  }
  say('');

  // 2. 근거 문서
  say('2/3  근거 문서');
  say('SRS의 근거가 될 문서를 하나씩 넣는다. 링크나 파일 경로를 붙여 넣고 Enter.');
  say('  예) Notion 페이지·데이터베이스 링크, Google 문서·드라이브 폴더, PDF·Word·한글·엑셀 파일,');
  say('      Figma 링크, 이슈 링크, 문서가 든 폴더, 또는 "고객사 메신저 대화 9월분" 같은 메모');
  say('  파일은 Finder에서 터미널로 끌어다 놓으면 경로가 들어간다. 다 넣었으면 빈 줄로 Enter.');
  say('');
  const added = [];
  let asked = 0;
  for (;;) {
    const input = await ask(`문서 ${++asked}`);
    if (input === null || input === '') break;
    const src = detectSource(input.replace(/\\ /g, ' '), process.cwd());
    if (src.kind === 'missing') {
      say(`  파일이 없습니다: ${src.file}. 다시 넣어 주세요.`);
      continue;
    }
    say(`  → ${src.ko}${src.title ? `: ${src.title}` : ''}`);
    const title = await ask('  제목', src.title || undefined);
    if (title === null) break;
    say(`  종류: ${SOURCE_KINDS.map((k, i) => `${i + 1} ${k.ko}`).join(' · ')}`);
    const guessIdx = SOURCE_KINDS.findIndex((k) => k.key === src.guess) + 1;
    const pick = await ask('  번호', String(guessIdx));
    const kind = SOURCE_KINDS[Number(pick) - 1] || SOURCE_KINDS[guessIdx - 1];
    let date = await ask('  문서 날짜(YYYY-MM-DD, 모르면 Enter)');
    if (date && !isDate(date)) {
      say('  날짜 형식이 아니라 비워 둔다.');
      date = '';
    }
    let group = false;
    let copy = false;
    let each = false;
    if (src.type === 'notion' || src.type === 'google' && src.tree) group = await yes('  하위 페이지까지 모두 근거인 묶음인가요?', true);
    if (src.kind === 'dir') each = await yes(`  폴더 안 문서 ${folderFiles(src.file).length}개를 하나씩 넣을까요?`, true);
    if (src.kind === 'file' || each) copy = await yes(`  읽은 판을 남기려고 사본을 보관함(${cfg.sourcesDir || 'srs-sources'}/)에 둘까요? git에는 올라가지 않는다`, true);
    if (src.kind === 'file') {
      const w = repoExposure(cfg, src.file);
      if (w) say(`  주의: ${w}`);
    }
    const before = added.length;
    const pages = loadPages(cfg);
    if (each) {
      for (const f of folderFiles(src.file)) {
        const fsrc = detectSource(f, process.cwd());
        const id = registerSource(cfg, loadPages(cfg).get, fsrc, { title: fsrc.title, kind, date, copy }, {});
        added.push({ id, label: `${fsrc.ko} · ${fsrc.title}` });
      }
      recordFolder(cfg, src, title, folderFiles(src.file), {});
      say(`  ${added.length - before}개를 넣었다(${added[before] ? added[before].id : ''}~${added[added.length - 1] ? added[added.length - 1].id : ''}).`);
    } else {
      const id = registerSource(cfg, pages.get, src, { title, kind, date, group: group || src.kind === 'dir', copy }, {});
      added.push({ id, label: `${src.ko} · ${title}`, group });
      say(`  ${id}로 넣었다.${group ? ' (묶음: 온보딩을 이어 갈 때 하위 문서를 모두 열어 한 행씩 넣는다)' : ''}`);
    }
    say('');
  }
  rl.close();

  // 3. 마무리
  say('3/3  다음 단계');
  if (!added.length) say('넣은 문서가 없다. 나중에 srs onboard를 다시 하거나 srs source add <링크|파일>로 넣는다.');
  else {
    say(`근거 문서 ${added.length}개를 출처 목록(${cfg.docsDir}/${cfg.pages.sources})에 "읽기 전"으로 넣었다.`);
    for (const a of added) say(`  ${a.id}  ${a.label}`);
  }
  say('');
  say('Claude Code에서 "SRS 온보딩 이어서"라고 하면, 읽기 전 출처를 열어 읽고(Notion·PDF·이미지·링크),');
  say('묶음의 하위 문서를 펼치고, 기능 목록과 첫 초안을 만든다. 남은 출처는 srs source list --unread.');
}

// ---------------------------------------------------------------- install, doctor

const SKILL_LINK = () => path.join(process.env.HOME || '', '.claude', 'skills', 'srs');
const SKILL_DIR = path.join(KIT_DIR, 'skill');

// 이 키트의 설치 상태
function installState() {
  const link = SKILL_LINK();
  let skill = 'missing';
  let skillTarget = null;
  try {
    const st = fs.lstatSync(link);
    if (st.isSymbolicLink()) {
      skillTarget = path.resolve(path.dirname(link), fs.readlinkSync(link));
      skill = exists(skillTarget) && fs.realpathSync(skillTarget) === fs.realpathSync(SKILL_DIR) ? 'ok' : 'other';
    } else skill = 'copy';
  } catch {
    /* 없음 */
  }
  const pathDirs = (process.env.PATH || '').split(path.delimiter);
  const onPath = pathDirs.find((d) => {
    const f = path.join(d, 'srs');
    try {
      return fs.realpathSync(f) === fs.realpathSync(path.join(KIT_DIR, 'bin', 'srs'));
    } catch {
      return false;
    }
  });
  const nodeMajor = Number(process.versions.node.split('.')[0]);
  return { link, skill, skillTarget, onPath: onPath || null, nodeOk: nodeMajor >= 18, node: process.versions.node };
}

function runInstall(opt) {
  const st = installState();
  const out = [];
  const link = st.link;
  if (st.skill === 'ok') out.push(`스킬: 이미 연결됨 (${shown(link)} → ${shown(SKILL_DIR)})`);
  else {
    if (st.skill !== 'missing' && !opt.force) die(`${link}가 이미 있다(${st.skill === 'copy' ? '링크가 아닌 폴더' : `다른 곳을 가리킴: ${st.skillTarget}`}). 바꾸려면 srs install --force`);
    if (st.skill !== 'missing') fs.rmSync(link, { recursive: true, force: true });
    fs.mkdirSync(path.dirname(link), { recursive: true });
    fs.symlinkSync(SKILL_DIR, link);
    out.push(`스킬: 연결함 (${shown(link)} → ${shown(SKILL_DIR)})`);
  }
  // 명령: PATH에 있는 사용자 bin 폴더(~/.local/bin, ~/bin)에 링크를 건다
  if (st.onPath) out.push(`명령: 이미 PATH에 있음 (${path.join(st.onPath, 'srs')})`);
  else {
    const home = process.env.HOME || '';
    const pathDirs = (process.env.PATH || '').split(path.delimiter);
    const dir = [path.join(home, '.local', 'bin'), path.join(home, 'bin')].find((d) => pathDirs.includes(d) && exists(d));
    const target = dir && path.join(dir, 'srs');
    if (target && !exists(target)) {
      fs.symlinkSync(path.join(KIT_DIR, 'bin', 'srs'), target);
      out.push(`명령: 연결함 (${target})`);
    } else {
      out.push('명령: PATH에 넣을 사용자 bin 폴더가 없어 건너뜀. 터미널에서 srs를 쓰려면 셸 설정(~/.zshrc 등)에:');
      out.push(`  alias srs="${path.join(KIT_DIR, 'bin', 'srs')}"`);
    }
  }
  if (!st.nodeOk) out.push(`주의: Node.js ${st.node}. 18 이상이 필요하다`);
  out.push('');
  out.push('다음: SRS를 세팅할 프로젝트 폴더에서 Claude Code를 열고 "SRS 온보딩", 또는 터미널에서 srs onboard <프로젝트 폴더>');
  out.push(`갱신: git -C "${KIT_DIR}" pull (스킬은 링크라 다시 설치하지 않는다)`);
  process.stdout.write(`${out.join('\n')}\n`);
}

function runDoctor(opt) {
  const st = installState();
  const lines = [
    `srs-kit: ${KIT_DIR}`,
    `Node.js: ${st.node}${st.nodeOk ? '' : ' (18 이상 필요)'}`,
    `스킬: ${{ ok: '연결됨', missing: '없음', other: `다른 곳을 가리킴(${st.skillTarget})`, copy: '링크가 아닌 폴더' }[st.skill]} (${shown(st.link)})`,
    `명령 srs: ${st.onPath ? path.join(st.onPath, 'srs') : 'PATH에 없음'}`,
  ];
  if (!opt.hook) {
    process.stdout.write(`${lines.join('\n')}\n${st.skill === 'ok' ? '' : '설치: node bin/srs install\n'}`);
    return;
  }
  // 세션 시작 훅: Claude에게 줄 안내(표준 출력이 세션 맥락에 들어간다)
  const ctx = ['[srs-kit] 이 폴더는 srs-kit 저장소다.', ...lines.map((l) => `- ${l}`)];
  if (st.skill === 'ok') ctx.push('설치는 끝나 있다. 사용자가 SRS 세팅을 원하면 "SRS 온보딩" 절차(skill/SKILL.md)를 대상 프로젝트 폴더에서 진행한다. 키트 자체를 고치는 작업이면 이 안내는 무시한다.');
  else {
    ctx.push('설치가 안 돼 있다. 사용자의 첫 메시지가 무엇이든 먼저 아래 온보딩을 시작한다(키트 자체를 고치러 온 것이 분명하면 묻고 건너뛴다).');
    ctx.push('1. 한 줄로 인사하고 `node bin/srs install`을 실행해 스킬과 명령을 연결한다. 결과를 짧게 알린다. 이미 다른 srs 스킬이 있다는 오류면 바꿀지 묻고 동의하면 --force.');
    ctx.push('2. "SRS를 세팅할 프로젝트 폴더 경로를 알려 주세요(없으면 새로 만들 폴더)."를 묻는다.');
    ctx.push('3. 받은 폴더에서 skill/SKILL.md의 "온보딩" 절차를 그대로 따른다: 기본 정보 → 근거 문서 링크·파일을 하나씩 받기 → 읽기 → 보고. 명령은 node bin/srs … --root <그 폴더> 로 실행한다.');
  }
  process.stdout.write(`${ctx.join('\n')}\n`);
}

// ---------------------------------------------------------------- main

const HELP = `srs — SRS 키트 도구 (기준: STANDARD.md, 순서: PROCESS.md)

사용법
  srs install [--force]
      이 키트를 설치한다: Claude Code 스킬 연결(~/.claude/skills/srs), srs 명령을 PATH의 사용자 bin 폴더에 연결.
  srs doctor [--hook]
      설치 상태를 보여 준다. --hook은 Claude Code 세션 시작 훅용 안내를 출력한다.
  srs onboard [<저장소>]
      처음 세팅을 묻고 답하며 한다: 기본 정보 → 근거 문서(Notion·Google 링크, PDF·Word·한글 파일, 폴더, 메모)를
      하나씩 붙여 넣으면 출처 목록에 "읽기 전"으로 넣는다. 이어서 Claude Code에서 "SRS 온보딩 이어서".
  srs source add <링크|파일|폴더|메모> [--kind contract|client|design|decision|code|old] [--title] [--date]
                 [--group] [--each] [--copy] [--dry-run]
      근거 문서 하나를 출처 목록(원문·번역)에 넣는다. --group 하위 문서까지 근거인 묶음, --each 폴더의 문서를 하나씩,
      --copy 파일 사본을 보관함(sourcesDir, git에 올라가지 않음)에 날짜별로 둔다. --edited 링크 문서의 수정일.
  srs source list [--unread]
      출처 목록을 보여 준다. --unread는 아직 읽지 않은 출처만.
  srs source status [--changed]
      넣을 때 기록한 지문과 지금 원본을 비교한다(파일 내용, 폴더의 문서 목록). 링크는 확인일·수정일을 보여 준다.
  srs source refresh <ID…> | --all [--copy] [--each] [--edited YYYY-MM-DD]
      다시 읽고 반영한 출처의 지문과 확인일을 지금 원본으로 고친다. 사본을 두던 출처는 날짜별 새 사본을 남긴다.
  srs init <저장소> [--name 이름] [--date YYYY-MM-DD] [--example] [--web <앱 폴더>] [--force]
      docs/srs 뼈대와 srs.config.json을 만든다. 있는 파일은 덮어쓰지 않는다.
      --example  예시 기능 페이지(주문 취소와 환불)를 함께 넣는다
      --web      문서 사이트 코드(Next.js + fumadocs)를 앱 폴더에 복사한다
  srs new <feature|policy> <slug> --title 제목 --code ABC [--description 설명] [--en-title Title]
      기능·정책 페이지를 한국어·영어로 만들고 meta.json에 넣는다.
  srs bump <페이지> [--note "바뀐 것"] [--date YYYY-MM-DD] [--lang ko|en|all] [--from YYYY-MM-DD]
      고치기 전에 실행한다. 지금 파일을 docs/srs-versions/<지금 version>/에 남기고 version을 올린다.
      --lang en  번역을 마친 뒤 영어 version을 원문 버전에 맞춘다
      --lang all 두 언어를 함께 올린다
  srs bump --edition --base <기준 커밋> --note "이번 판" [--note-en "..."] [--date YYYY-MM-DD] [--dry-run]
      판 단위로 올린다. 고친 뒤에 실행한다. 기준 커밋 뒤 바뀐 페이지를 모두 같은 날짜로 한·영 함께 올리고,
      기준 커밋의 파일을 예전 버전으로 남긴다(generatedPages는 남기지 않음).
  srs check [--base <기준 커밋>] [--json] [--strict] [--verbose] [--limit N] [--baseline | --save-baseline]
      모든 페이지를 검사한다. 오류가 있으면 종료 코드 1(--strict면 경고도 1).
      --base           버전을 올린 페이지의 versionNote와 예전 버전 파일을 기준 커밋과 대조한다
      --save-baseline  지금 오류·경고를 기준선 파일(checkBaseline)에 남긴다. 기존 SRS를 들일 때 한 번
      --baseline       기준선에 있는 오류·경고는 숨기고 그 뒤에 생긴 것만 보여 준다(종료 코드도 그것만으로)
  srs status [--all]
      기능·정책 페이지의 버전, 번역, 상태, 확인 현황을 표로 출력한다(확인 기록 페이지에 붙여 넣는다).
  srs sync trace [--dry-run] [--verbose]
      추적표에 빠진 규칙 행을 넣고 출처·요약 칸을 페이지에 맞춘다. 다른 칸은 그대로 둔다.
  srs sync impl [--from <대조 보고서>] [--commit <SHA>] [--date YYYY-MM-DD] [--prune] [--dry-run]
      구현 대조 결과를 옮긴다. --from 보고서의 상태를 추적표 구현 상태 열(번역은 고정 번역)에 쓰고,
      구현 상태 페이지의 기준·요약 숫자를 다시 세고, "다르게 구현됨"·"미구현" 표에 빠진 행을 넣는다.
      있는 행의 글은 고치지 않는다. --prune  상태가 바뀐 행을 지운다
  srs sync links [--dry-run]
      링크 글자를 가리키는 페이지 제목으로 바꾼다(한국어 조사도 맞춘다).

공통 옵션
  --root <폴더>     저장소 루트(기본: srs.config.json이 있는 가장 가까운 상위 폴더, 없으면 현재 폴더)
  --config <파일>   설정 파일(기본: <root>/srs.config.json)
`;

function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const { pos, opt } = parseArgs(rest);
  if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h' || opt.help) {
    process.stdout.write(HELP);
    return;
  }
  if (cmd === 'install') return runInstall(opt);
  if (cmd === 'doctor') return runDoctor(opt);
  if (cmd === 'init') return runInit(pos, opt);
  if (cmd === 'onboard') return runOnboard(pos, opt);
  const cfg = loadConfig(opt);
  if (cmd === 'check') {
    const result = runCheck(cfg, opt);
    if (opt['save-baseline']) return saveCheckBaseline(cfg, result);
    if (opt.baseline) applyCheckBaseline(cfg, result);
    const levels = printCheck(result, cfg, opt);
    process.exitCode = levels.error > 0 || (opt.strict && levels.warn > 0) ? 1 : 0;
    return;
  }
  if (cmd === 'status') return runStatus(cfg, opt);
  if (cmd === 'bump') return runBump(cfg, pos, opt);
  if (cmd === 'new') return runNew(cfg, pos, opt);
  if (cmd === 'source') {
    if (pos[0] === 'add') return runSourceAdd(cfg, pos.slice(1), opt);
    if (pos[0] === 'list') return runSourceList(cfg, opt);
    if (pos[0] === 'status') return runSourceStatus(cfg, opt);
    if (pos[0] === 'refresh') return runSourceRefresh(cfg, pos.slice(1), opt);
    die('srs source add <위치> | list | status | refresh <ID>');
  }
  if (cmd === 'sync') {
    if (pos[0] === 'trace') return runSyncTrace(cfg, opt);
    if (pos[0] === 'impl') return runSyncImpl(cfg, opt);
    if (pos[0] === 'links') return runSyncLinks(cfg, opt);
    die('srs sync trace | srs sync impl | srs sync links');
  }
  die(`알 수 없는 명령: ${cmd} (srs help)`);
}

main();
